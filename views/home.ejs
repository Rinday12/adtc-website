<%- include('layout/header', { title }) %>

<%
  // Gambar ilustrasi per slide (cycling jika training > 3)
  const slideImages = [
    '/images/trainings/training-1.svg',
    '/images/trainings/training-2.svg',
    '/images/trainings/training-3.svg',
  ]

  // Warna overlay gradient per slide untuk kontras teks
  const overlayColors = [
    'rgba(27,58,107,0.78)',   // biru gelap
    'rgba(27,58,107,0.82)',   // indigo
    'rgba(27,58,107,0.75)',     // hijau gelap
  ]

  const fmtHero = new Intl.NumberFormat('id-ID', {
    style: 'currency', currency: 'IDR', minimumFractionDigits: 0
  })
%>

<!-- ─── Hero Slider ─────────────────────────────────────────── -->
<div id="hero-slider"
     class="relative rounded-2xl overflow-hidden shadow-xl mb-14"
     style="min-height: 400px;"
     role="region"
     aria-label="Slideshow pelatihan unggulan ADTC">

  <% if (trainings && trainings.length > 0) { %>

    <% trainings.forEach(function(training, idx) { %>
      <%
        const imgSrc     = slideImages[idx % slideImages.length]
        const overlay    = overlayColors[idx % overlayColors.length]
        const heroDate   = training.start_date
          ? new Date(training.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
          : 'Segera diumumkan'
      %>
      <div class="hero-slide absolute inset-0 opacity-0 pointer-events-none"
           aria-hidden="true">

        <!-- Background image -->
        <img src="<%= imgSrc %>"
             alt=""
             aria-hidden="true"
             class="absolute inset-0 w-full h-full object-cover"
             style="object-position: center center;" />

        <!-- Overlay gradient untuk keterbacaan teks -->
        <div class="absolute inset-0" style="background: <%= overlay %>;"></div>

        <!-- Konten slide -->
        <div class="relative z-10 flex flex-col items-center justify-center
                    h-full px-8 py-16 text-center text-white min-h-[400px]">

          <!-- Badge label -->
          <span class="inline-block bg-white/20 border border-white/30 backdrop-blur-sm
                       text-xs font-semibold uppercase tracking-widest px-3 py-1
                       rounded-full mb-5">
            Pelatihan Terdekat
          </span>

          <!-- Judul training -->
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight max-w-3xl mb-4 drop-shadow-lg">
            <%= training.title %>
          </h1>

          <!-- Deskripsi singkat -->
          <% if (training.description) { %>
            <p class="text-white/75 text-sm sm:text-base max-w-xl mb-6 leading-relaxed">
              <%= training.description.length > 120
                    ? training.description.substring(0, 120).trimEnd() + '...'
                    : training.description %>
            </p>
          <% } %>

          <!-- Meta: tanggal + harga -->
          <div class="flex flex-wrap justify-center gap-4 text-sm text-white/80 mb-8">
            <span class="flex items-center gap-1.5 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <%= heroDate %>
            </span>
            <% if (training.price_general) { %>
              <span class="flex items-center gap-1.5 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                </svg>
                Mulai <%= fmtHero.format(training.price_general) %>
              </span>
            <% } %>
          </div>

          <!-- CTA buttons -->
          <div class="flex flex-wrap justify-center gap-3">
            <a href="/trainings/<%= training.slug %>/register"
               class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-bold
                      px-7 py-3 rounded-xl shadow-lg active:scale-95
                      transition-all duration-150">
              Daftar Sekarang
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/trainings/<%= training.slug %>"
               class="inline-flex items-center gap-2 border border-white/60 text-white
                      font-semibold px-6 py-3 rounded-xl hover:bg-white/10
                      active:scale-95 transition-all duration-150">
              Lihat Detail
            </a>
          </div>
        </div>
      </div>
    <% }) %>

  <% } else { %>

    <!-- Fallback: tidak ada training aktif -->
    <div class="hero-slide absolute inset-0 opacity-0 pointer-events-none" aria-hidden="true">
      <img src="/images/trainings/training-1.svg" alt="" aria-hidden="true"
           class="absolute inset-0 w-full h-full object-cover"/>
      <div class="absolute inset-0" style="background: rgba(27,58,107,0.80);"></div>
      <div class="relative z-10 flex flex-col items-center justify-center h-full
                  px-8 py-16 text-center text-white min-h-[400px]">
        <h1 class="text-4xl font-extrabold mb-3 drop-shadow-lg">Ahmad Dahlan Training Center</h1>
        <p class="text-xl text-blue-100 font-semibold mb-4">Tingkatkan Kompetensi, Raih Prestasi</p>
        <p class="text-base text-blue-200 max-w-2xl mx-auto mb-8">
          Lembaga pelatihan profesional yang berkomitmen menghadirkan program berkualitas tinggi
          untuk individu dan organisasi.
        </p>
        <a href="/trainings"
           class="inline-block bg-brand-500 hover:bg-brand-600 text-white font-bold px-7 py-3
                  rounded-xl hover:bg-blue-50 transition-colors shadow-lg">
          Lihat Semua Pelatihan
        </a>
      </div>
    </div>

  <% } %>

  <!-- Spacer agar container memiliki tinggi (slide-slide absolut) -->
  <div class="invisible pointer-events-none px-8" style="min-height: 400px;">
    <div class="pt-16 pb-16">
      <div class="text-4xl font-extrabold mb-3 opacity-0">x</div>
      <div class="text-xl mb-4 opacity-0">x</div>
      <div class="text-base mb-8 opacity-0">x</div>
      <div class="h-12 opacity-0">x</div>
    </div>
  </div>

  <!-- Panah kiri -->
  <button id="slider-prev"
          class="absolute left-3 top-1/2 -translate-y-1/2 z-20
                 bg-black/25 hover:bg-black/40 backdrop-blur-sm border border-white/20
                 rounded-full w-11 h-11 flex items-center justify-center
                 text-white transition-colors focus:outline-none focus:ring-2 focus:ring-white"
          aria-label="Slide sebelumnya">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <!-- Panah kanan -->
  <button id="slider-next"
          class="absolute right-3 top-1/2 -translate-y-1/2 z-20
                 bg-black/25 hover:bg-black/40 backdrop-blur-sm border border-white/20
                 rounded-full w-11 h-11 flex items-center justify-center
                 text-white transition-colors focus:outline-none focus:ring-2 focus:ring-white"
          aria-label="Slide berikutnya">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <!-- Dot indicators -->
  <div class="absolute bottom-5 left-0 right-0 flex justify-center gap-2 z-20"
       role="tablist" aria-label="Pilih slide">
    <% if (trainings && trainings.length > 0) { %>
      <% trainings.forEach(function(_, idx) { %>
        <button class="hero-dot h-2.5 w-2.5 rounded-full bg-white/40
                       transition-all duration-300 focus:outline-none"
                role="tab" aria-label="Slide <%= idx + 1 %>">
        </button>
      <% }) %>
    <% } else { %>
      <button class="hero-dot h-2.5 w-2.5 rounded-full bg-white/40" role="tab" aria-label="Slide 1"></button>
    <% } %>
  </div>

</div>


<!-- ─── Keunggulan ADTC ──────────────────────────────────────── -->
<div class="mb-16">

  <!-- Section header — eye-catching -->
  <div class="text-center mb-12">
    <!-- Badge pill -->
    <span class="inline-block bg-navy-50 text-navy-700 text-xs font-bold
                 uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 border border-navy-200">
      Mengapa Memilih ADTC?
    </span>

    <!-- Heading utama dengan gradient -->
    <h2 class="text-3xl sm:text-4xl font-extrabold mb-4 leading-tight">
      <span class="bg-gradient-to-r from-navy-700 via-brand-500 to-brand-600
                   bg-clip-text text-transparent">
        Keunggulan ADTC
      </span>
    </h2>

    <!-- Garis dekoratif di bawah heading -->
    <div class="flex justify-center mb-4">
      <div class="h-1 w-12 rounded-full bg-brand-500"></div>
      <div class="h-1 w-4 rounded-full bg-brand-300 mx-1"></div>
      <div class="h-1 w-2 rounded-full bg-brand-200"></div>
    </div>

    <p class="text-gray-500 max-w-xl mx-auto text-base leading-relaxed">
      Alasan mengapa ribuan peserta mempercayakan pengembangan diri mereka kepada kami.
    </p>
  </div>

  <!-- Grid benefit cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

    <!-- 1. Online / Offline -->
    <div class="reveal-card group bg-white rounded-2xl border border-gray-100 shadow-sm p-7
                hover:shadow-xl hover:-translate-y-1.5 hover:border-navy-200
                transition-all duration-300 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl
                  bg-navy-50 group-hover:bg-navy-100 transition-colors mb-5 mx-auto">
        <svg class="w-7 h-7 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <h3 class="text-sm font-extrabold tracking-widest text-navy-700 uppercase mb-2">
        Online / Offline
      </h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Pilihan metode belajar fleksibel sesuai kebutuhan Anda, bisa tatap muka atau dari rumah.
      </p>
    </div>

    <!-- 2. Pusat Download -->
    <div class="reveal-card group bg-white rounded-2xl border border-gray-100 shadow-sm p-7
                hover:shadow-xl hover:-translate-y-1.5 hover:border-navy-200
                transition-all duration-300 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl
                  bg-navy-50 group-hover:bg-navy-100 transition-colors mb-5 mx-auto">
        <svg class="w-7 h-7 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 10h10M7 14h6"/>
        </svg>
      </div>
      <h3 class="text-sm font-extrabold tracking-widest text-navy-700 uppercase mb-2">
        Pusat Download
      </h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Dapatkan sertifikat resmi yang diakui untuk menunjang portofolio karier Anda.
      </p>
    </div>

    <!-- 3. Mentor Profesional -->
    <div class="reveal-card group bg-white rounded-2xl border border-gray-100 shadow-sm p-7
                hover:shadow-xl hover:-translate-y-1.5 hover:border-navy-200
                transition-all duration-300 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl
                  bg-navy-50 group-hover:bg-navy-100 transition-colors mb-5 mx-auto">
        <svg class="w-7 h-7 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <h3 class="text-sm font-extrabold tracking-widest text-navy-700 uppercase mb-2">
        Mentor Profesional
      </h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Dibimbing langsung oleh praktisi industri dan akademisi ahli berpengalaman.
      </p>
    </div>

    <!-- 4. Networking -->
    <div class="reveal-card group bg-white rounded-2xl border border-gray-100 shadow-sm p-7
                hover:shadow-xl hover:-translate-y-1.5 hover:border-navy-200
                transition-all duration-300 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl
                  bg-navy-50 group-hover:bg-navy-100 transition-colors mb-5 mx-auto">
        <svg class="w-7 h-7 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <h3 class="text-sm font-extrabold tracking-widest text-navy-700 uppercase mb-2">
        Networking
      </h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Terhubung dengan jaringan luas profesional dan sesama peserta untuk memperluas relasi.
      </p>
    </div>

    <!-- 5. Info Lowongan Pekerjaan -->
    <div class="reveal-card group bg-white rounded-2xl border border-gray-100 shadow-sm p-7
                hover:shadow-xl hover:-translate-y-1.5 hover:border-navy-200
                transition-all duration-300 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl
                  bg-navy-50 group-hover:bg-navy-100 transition-colors mb-5 mx-auto">
        <svg class="w-7 h-7 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
      <h3 class="text-sm font-extrabold tracking-widest text-navy-700 uppercase mb-2">
        Info Lowongan Pekerjaan
      </h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Dapatkan informasi peluang karier dan penyaluran kerja eksklusif bagi alumni bersertifikat.
      </p>
    </div>

    <!-- 6. Open Trainer -->
    <div class="reveal-card group bg-white rounded-2xl border border-gray-100 shadow-sm p-7
                hover:shadow-xl hover:-translate-y-1.5 hover:border-navy-200
                transition-all duration-300 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl
                  bg-navy-50 group-hover:bg-navy-100 transition-colors mb-5 mx-auto">
        <svg class="w-7 h-7 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5
               m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
      </div>
      <h3 class="text-sm font-extrabold tracking-widest text-navy-700 uppercase mb-2">
        Open Trainer
      </h3>
      <p class="text-sm text-gray-500 leading-relaxed">
        Terbuka bagi trainer profesional untuk bergabung dan berbagi keahlian bersama komunitas ADTC.
      </p>
    </div>

  </div>
</div>


<!-- ─── Training Unggulan ────────────────────────────────────── -->
<div class="mb-14">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-800 mb-1">Training Unggulan</h2>
      <p class="text-gray-500">Program pelatihan aktif terbaru dari ADTC.</p>
    </div>
    <a href="/trainings" class="text-sm text-navy-700 hover:underline font-medium shrink-0">
      Lihat Semua →
    </a>
  </div>

  <% if (trainings && trainings.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% trainings.forEach(function(training, cardIdx) { %>
        <%
          const fmtCard = new Intl.NumberFormat('id-ID', {
            style: 'currency', currency: 'IDR', minimumFractionDigits: 0
          })
          const cardDate = training.start_date
            ? new Date(training.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
            : 'Segera diumumkan'
          const shortDesc = training.description
            ? (training.description.length > 100
                ? training.description.substring(0, 100).trimEnd() + '...'
                : training.description)
            : ''
          const cardImg = slideImages[cardIdx % slideImages.length]
          const registeredCount = training.registered_count || 0
          const isFull = registeredCount >= training.quota
          const isPostpone = training.status === 'postpone'
          // Selesai = tanggal efektif (reschedule_date bila ada, selain itu
          // start_date) sudah lewat.
          const effDate = training.reschedule_date || training.start_date
          const isCompleted = !!effDate && new Date(effDate) < new Date()
          const isBlocked = isCompleted || isFull
          const statusLabel = isCompleted ? 'Selesai' : (isPostpone ? 'Postpone' : (isFull ? 'Penuh' : 'Buka'))
          const statusClass = isCompleted ? 'bg-blue-100 text-blue-800 border-blue-200' : (isPostpone ? 'bg-yellow-100 text-yellow-800 border-yellow-300' : (isFull ? 'bg-red-100 text-red-800 border-red-200' : 'bg-green-100 text-green-800 border-green-200'))
          const statusDot = isCompleted ? 'bg-blue-500' : (isPostpone ? 'bg-yellow-500' : (isFull ? 'bg-red-500' : 'bg-green-500'))
        %>
        <div class="reveal-card bg-white rounded-2xl border border-gray-200 shadow-sm flex flex-col
                    hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden">

          <!-- Thumbnail gambar -->
          <div class="relative h-40 overflow-hidden bg-gray-100">
            <img src="<%= cardImg %>" alt="<%= training.title %>"
                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"/>
            <div class="absolute inset-0" style="background: rgba(27,58,107,0.50);"></div>
            <!-- Status badge -->
            <div class="absolute top-3 right-3">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full border <%= statusClass %>">
                <span class="w-2 h-2 rounded-full <%= statusDot %>"></span>
                <%= statusLabel %>
              </span>
            </div>
            <h3 class="absolute bottom-0 left-0 right-0 px-4 py-3 text-sm font-bold text-white
                       leading-snug drop-shadow"><%= training.title %></h3>
          </div>

          <div class="px-5 py-4 flex flex-col flex-1 gap-3">
            <% if (shortDesc) { %>
              <p class="text-sm text-gray-600 leading-relaxed"><%= shortDesc %></p>
            <% } %>
            <div class="space-y-1 text-sm">
              <div class="flex items-center gap-2 text-gray-500">
                <span class="text-base" aria-hidden="true">📅</span>
                <span><%= cardDate %></span>
              </div>
              <% if (training.price_general) { %>
                <div class="flex items-center gap-2">
                  <span class="text-base" aria-hidden="true">💰</span>
                  <span class="text-gray-500">Mulai dari</span>
                  <span class="font-semibold text-navy-700"><%= fmtCard.format(training.price_general) %></span>
                </div>
              <% } %>
            </div>
            <div class="flex-1"></div>
            <div class="flex flex-col gap-2 pt-1">
              <% if (isBlocked) { %>
                <button disabled
                        class="inline-flex justify-center items-center gap-1.5 w-full
                               bg-gray-100 text-gray-600 font-bold text-sm
                               px-4 py-2.5 rounded-xl cursor-not-allowed border border-gray-200">
                  <span class="w-2 h-2 rounded-full <%= isCompleted ? 'bg-blue-500' : 'bg-red-500' %>"></span>
                  <%= isCompleted ? 'Sudah Selesai' : 'Kuota Penuh' %>
                </button>
              <% } else { %>
                <a href="/trainings/<%= training.slug %>/register"
                   class="inline-flex justify-center items-center gap-1.5 w-full
                          bg-brand-500 hover:bg-brand-600 active:bg-brand-700
                          text-white font-bold text-sm px-4 py-2.5 rounded-xl
                          transition-colors shadow-sm">
                  Daftar Sekarang
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              <% } %>
              <a href="/trainings/<%= training.slug %>"
                 class="inline-flex justify-center items-center gap-1 w-full
                        border border-gray-300 text-gray-600 hover:border-blue-400 hover:text-navy-700
                        font-medium text-sm px-4 py-2 rounded-xl transition-colors">
                Lihat Detail
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  <% } else { %>
    <div class="flex flex-col items-center justify-center py-16 text-center bg-white rounded-2xl border border-gray-200">
      <div class="text-5xl mb-4" aria-hidden="true">📋</div>
      <p class="text-gray-500 text-sm">Belum ada pelatihan aktif.</p>
    </div>
  <% } %>
</div>


<!-- ─── Navigasi Bawah ───────────────────────────────────────── -->
<div class="flex flex-wrap justify-center gap-4 mb-4">
  <a href="/trainings"
     class="inline-block bg-brand-500 hover:bg-brand-600 text-white font-semibold
            px-8 py-3 rounded-xl transition-colors">
    Lihat Semua Pelatihan
