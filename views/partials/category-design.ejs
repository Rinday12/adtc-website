// views/partials/category-design.ejs
// Partial helper: map nama aksen (di tabel categories) ke class CSS lengkap.
// Dipakai di category.ejs & catalog.ejs.

<%
  function catDesign(accent) {
    var palet = {
      blue: {
        heroBg: 'bg-gradient-to-br from-blue-600 to-blue-800',
        barBg:  'bg-blue-500',
        dot:    'bg-blue-500',
        badge:  'bg-blue-100 text-blue-800 border border-blue-200'
      },
      navy: {
        heroBg: 'bg-gradient-to-br from-[#1B3A6B] to-[#0e1f3a]',
        barBg:  'bg-[#1B3A6B]',
        dot:    'bg-[#1B3A6B]',
        badge:  'bg-navy-50 text-navy-700 border border-navy-200'
      },
      teal: {
        heroBg: 'bg-gradient-to-br from-teal-600 to-teal-800',
        barBg:  'bg-teal-600',
        dot:    'bg-teal-600',
        badge:  'bg-teal-50 text-teal-800 border border-teal-200'
      },
      green: {
        heroBg: 'bg-gradient-to-br from-green-600 to-green-800',
        barBg:  'bg-green-600',
        dot:    'bg-green-500',
        badge:  'bg-green-50 text-green-800 border border-green-200'
      },
      purple: {
        heroBg: 'bg-gradient-to-br from-purple-600 to-purple-800',
        barBg:  'bg-purple-600',
        dot:    'bg-purple-500',
        badge:  'bg-purple-50 text-purple-800 border border-purple-200'
      },
      red: {
        heroBg: 'bg-gradient-to-br from-red-600 to-red-800',
        barBg:  'bg-red-600',
        dot:    'bg-red-500',
        badge:  'bg-red-50 text-red-800 border border-red-200'
      }
    }
    return palet[accent] || palet.blue
  }
%>
