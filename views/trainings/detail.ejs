<%- include('../layout/header') %>

<%
  const fmt = new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0
  });

  const startDate = training.start_date ? new Date(training.start_date) : null;
  const formattedDate = startDate
    ? startDate.toLocaleDateString('id-ID', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      })
    : 'Belum ditentukan';
%>

<div class="max-w-3xl mx-auto">

  <!-- Back link -->
  <a href="/trainings" class="inline-flex items-center gap-1 text-brand-500 hover:text-navy-800 text-sm mb-6 transition-colors">
    <span aria-hidden="true">&#8592;</span>
    <span>Kembali ke Katalog</span>
  </a>

  <!-- Training Card -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">

    <!-- Cover Image -->
    <% if (training.cover_image) { %>
      <div class="overflow-hidden bg-white">
        <img src="/<%= training.cover_image %>" alt="<%= training.title %>"
             class="w-full h-auto object-contain" style="max-height: 420px;">
      </div>
    <% } else { %>
      <div class="h-48 bg-navy-700 flex items-center justify-center">
        <span class="text-white/60 text-sm font-medium uppercase tracking-widest"><%= training.category %></span>
      </div>
    <% } %>

    <!-- Header -->
    <div class="px-8 py-6">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-snug mb-3">
        <%= training.title %>
      </h1>
      <%
        const isFull    = training.status === 'full' || (training.registered_count || 0) >= training.quota
        const effective = training.reschedule_date || training.start_date
        const isEnded   = !!effective && new Date(effective) < new Date()
      %>
      <% if (isEnded) { %>
        <span class="inline-block bg-blue-500 text-white text-xs font-semibold px-3 py-1 rounded-full">
          Selesai
        </span>
      <% } else if (isFull) { %>
        <span class="inline-block bg-red-500 text-white text-xs font-semibold px-3 py-1 rounded-full">
          Kuota Penuh
        </span>
      <% } else if (training.status === 'postpone') { %>
        <span class="inline-block bg-yellow-500 text-white text-xs font-semibold px-3 py-1 rounded-full">
          Postpone
        </span>
      <% } else { %>
        <span class="inline-block bg-green-400 text-white text-xs font-semibold px-3 py-1 rounded-full">
          Pendaftaran Dibuka
        </span>
      <% } %>
    </div>

    <div class="px-8 py-6 space-y-8">

      <!-- Deskripsi -->
      <section aria-labelledby="desc-heading">
        <h2 id="desc-heading" class="text-lg font-semibold text-gray-800 mb-2">Deskripsi Pelatihan</h2>
        <p class="text-gray-600 leading-relaxed whitespace-pre-line">
          <%= training.description || 'Tidak ada deskripsi tersedia.' %>
        </p>
      </section>

      <hr class="border-gray-100" />

      <!-- Jadwal & Kuota -->
      <section aria-label="Info jadwal dan kuota" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-brand-500 text-lg" aria-hidden="true">
            📅
          </div>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Jadwal Mulai</p>
            <%
              let displayDate = formattedDate
              if (training.status === 'postpone' && training.reschedule_date) {
                displayDate = new Date(training.reschedule_date).toLocaleDateString('id-ID', {
                  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
                })
              }
            %>
            <p class="text-gray-800 font-semibold"><%= displayDate %></p>
            <% if (training.status === 'postpone' && training.reschedule_date) { %>
              <p class="text-xs text-yellow-600 mt-1">Jadwal diundur ke tanggal baru</p>
            <% } %>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-brand-500 text-lg" aria-hidden="true">
            👥
          </div>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Kuota Peserta</p>
            <p class="text-gray-800 font-semibold">
              <%= (training.registered_count || 0) %> / <%= training.quota %> orang
            </p>
            <% if ((training.registered_count || 0) >= training.quota) { %>
              <p class="text-xs text-red-600 mt-1">Kuota Penuh</p>
            <% } else { %>
              <p class="text-xs text-green-600 mt-1">Tersisa <%= training.quota - (training.registered_count || 0) %> slot</p>
            <% } %>
          </div>
        </div>
      </section>

      <hr class="border-gray-100" />

      <!-- Mode Pelaksanaan & Fasilitas -->
      <%
        const isOnline = training.exec_mode === 'online'
        const fasilitasList = isOnline ? [] :
          (training.fasilitas || '').split('\n').map(s => s.trim()).filter(Boolean)
        const modeLabel = isOnline ? 'Pelaksanaan Online' : 'Pelaksanaan Offline'
        const modeDesc  = isOnline
          ? 'Dikuti dari mana saja via daring'
          : 'Pelatihan tatap muka di fasilitas ADTC'
      %>
      <section aria-label="Mode pelaksanaan" class="flex items-center gap-3 rounded-xl bg-navy-700 text-white px-4 py-3">
        <div class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center text-xl shrink-0" aria-hidden="true">
          <%= isOnline ? '💻' : '🏢' %>
        </div>
        <div>
          <p class="font-semibold text-sm leading-tight"><%= modeLabel %></p>
          <p class="text-navy-200 text-xs mt-0.5"><%= modeDesc %></p>
        </div>
      </section>

      <% if (!isOnline && fasilitasList.length > 0) { %>
      <section aria-labelledby="fasilitas-heading" class="mt-4">
        <h2 id="fasilitas-heading" class="text-lg font-semibold text-gray-800 mb-1">Fasilitas yang Didapat</h2>
        <p class="text-sm text-gray-500 mb-4">Berikut yang tersedia untuk peserta pelatihan ini.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% fasilitasList.forEach(function(f, idx) { %>
          <div class="flex items-center gap-3 rounded-xl border border-gray-100 bg-white
                      hover:border-brand-200 hover:shadow-sm transition-all duration-200 px-4 py-3">
            <span class="w-7 h-7 rounded-full bg-brand-50 text-brand-500 font-bold text-sm
                         flex items-center justify-center shrink-0" aria-hidden="true">
              <%= idx + 1 %>
            </span>
            <span class="text-sm font-medium text-gray-800"><%= f %></span>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>

      <hr class="border-gray-100" />

      <!-- Biaya Pendaftaran -->
      <%
        // Full gratis (kategori is_free_tier + cert_available=0): tidak ada
        // pembayaran sama sekali → bagian biaya dinonaktifkan, diganti banner.
        const isFullFree = !!training.is_free_tier && training.cert_available === false
      %>
      <section aria-labelledby="price-heading">
        <% if (isFullFree) { %>
          <h2 id="price-heading" class="text-lg font-semibold text-gray-800 mb-4">Biaya Pendaftaran</h2>
          <div class="rounded-xl border border-green-200 bg-green-50 px-5 py-4 flex items-center gap-3">
            <span class="text-green-600 text-lg flex-shrink-0" aria-hidden="true">&#9989;</span>
            <div>
              <p class="text-sm font-semibold text-green-800">Pelatihan ini sepenuhnya gratis</p>
              <p class="text-xs text-green-700 mt-0.5">Tidak ada biaya pendaftaran maupun opsi pembayaran lainnya — ikut Rp 0 total.</p>
            </div>
          </div>
        <% } else { %>
          <h2 id="price-heading" class="text-lg font-semibold text-gray-800 mb-4">Biaya Pendaftaran</h2>
          <div class="rounded-xl border border-gray-200 overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-5 py-3 text-left font-semibold text-gray-600" scope="col">Kategori Peserta</th>
                  <th class="px-5 py-3 text-right font-semibold text-gray-600" scope="col">Biaya</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-5 py-4 text-gray-700">Umum</td>
                  <td class="px-5 py-4 text-right font-semibold text-gray-800">
                    <%= training.price_general != null ? fmt.format(training.price_general) : '-' %>
                  </td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-5 py-4 text-gray-700">
                    Mahasiswa UAD
                    <span class="ml-1 inline-block bg-blue-100 text-navy-700 text-xs font-medium px-2 py-0.5 rounded-full">KTM wajib</span>
                  </td>
                  <td class="px-5 py-4 text-right font-semibold text-gray-800">
                    <%= training.price_student_uad != null ? fmt.format(training.price_student_uad) : '-' %>
                  </td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-5 py-4 text-gray-700">
                    Karyawan UAD
                    <span class="ml-1 inline-block bg-purple-100 text-purple-700 text-xs font-medium px-2 py-0.5 rounded-full">ID Card wajib</span>
                  </td>
                  <td class="px-5 py-4 text-right font-semibold text-gray-800">
                    <%= training.price_employee_uad != null ? fmt.format(training.price_employee_uad) : '-' %>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-gray-400">* Mahasiswa dan karyawan UAD wajib mengunggah dokumen identitas saat pendaftaran.</p>
          <p class="mt-1 text-xs text-gray-400">Pilih kategori yang sesuai saat mendaftar — kategori menentukan harga yang berlaku dan berkas dokumen yang diminta.</p>

          <% if (training.is_free_tier && certFee > 0) { %>
          <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-5 py-4">
            <div class="flex items-start gap-3">
              <span class="text-amber-500 text-lg flex-shrink-0 mt-0.5" aria-hidden="true">&#9432;</span>
              <div>
                <p class="text-sm font-semibold text-amber-800">Pelatihan ini gratis</p>
                <p class="text-xs text-amber-700 mt-1">
                  Pendaftaran tidak dipungut biaya. Untuk mendapatkan sertifikat,
                  biaya sebesar <strong class="text-amber-800"><%= fmt.format(certFee) %></strong>
                  akan dibayarkan setelah verifikasi admin.
                </p>
              </div>
            </div>
          </div>
          <% } %>
        <% } %>
      </section>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
        <%
          // Postpone = jadwal diundur, bukan ditutup: peserta tetap boleh mendaftar
          // (termasuk sebelum reschedule_date terisi oleh admin).
          // Yang mengunci tombol: kuota habis ATAU pelatihan sudah selesai
          // (tanggal efektif = reschedule_date bila ada, selain itu start_date,
          // sudah lewat hari ini).
          const isFullNow = (training.registered_count || 0) >= training.quota
          const effDate   = training.reschedule_date || training.start_date
          const isEndedCTA = !!effDate && new Date(effDate) < new Date()
          const canRegister = !isFullNow && !isEndedCTA
        %>
        <% if (canRegister) { %>
          <a
            href="/trainings/<%= training.slug %>/register"
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-brand-500 hover:bg-navy-700 active:bg-brand-700 text-white font-semibold px-8 py-3 rounded-xl shadow-sm transition-colors text-base"
          >
            Daftar Sekarang
            <span aria-hidden="true">&#8594;</span>
          </a>
          <% if (training.status === 'postpone') { %>
            <p class="text-xs text-yellow-600">
              Jadwal sedang diundur — pendaftaran tetap terbuka
              <%= training.reschedule_date ? '(tanggal baru: ' + new Date(training.reschedule_date).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) + ')' : '(menunggu jadwal baru)' %>
            </p>
          <% } %>
        <% } else { %>
          <button
            disabled
            aria-disabled="true"
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-gray-300 text-gray-500 font-semibold px-8 py-3 rounded-xl cursor-not-allowed text-base"
          >
            <% if (isEndedCTA) { %>Sudah Selesai<% } else { %>Kuota Penuh<% } %>
          </button>
        <% } %>

        <a href="/trainings" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
          <span aria-hidden="true">&#8592;</span> Kembali ke Katalog
        </a>
      </div>

    </div>
  </div>

</div>

<%- include('../layout/footer') %>
