<%- include('../layout/header') %>

<div class="max-w-2xl mx-auto">

  <!-- Success Banner -->
  <div class="bg-green-50 border border-green-200 rounded-xl p-6 mb-6 flex items-start gap-4">
    <div class="shrink-0 w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
      <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <div>
      <h1 class="text-2xl font-bold text-green-800">Bukti Pembayaran Terkirim!</h1>
      <p class="text-green-700 mt-1 text-sm">
        Terima kasih telah mengunggah bukti pembayaran. Admin akan memverifikasi secepatnya.
      </p>
    </div>
  </div>

  <!-- Registration summary -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-6">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-base font-semibold text-gray-800">Ringkasan</h2>
    </div>
    <dl class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Peserta</dt>
        <dd class="text-sm font-medium text-gray-900 text-right"><%= registration.full_name %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Program</dt>
        <dd class="text-sm font-medium text-gray-900 text-right"><%= registration.training_title %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Total Tagihan</dt>
        <dd class="text-base font-bold text-navy-700 text-right"><%= fmt.format(registration.final_price) %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Status</dt>
        <dd class="text-right">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-800 border border-orange-200">
            Menunggu Verifikasi Admin
          </span>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Info card -->
  <% if (groupLink) { %>
  <div class="bg-green-50 border border-green-200 rounded-xl p-5 mb-6">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
      <div>
        <p class="text-sm font-semibold text-green-800">Grup WhatsApp Peserta</p>
        <p class="text-sm text-green-700 mt-1">
          Anda telah ditambahkan ke grup WhatsApp pelatihan. Silakan bergabung untuk koordinasi dan informasi lanjutan.
        </p>
        <a href="<%= groupLink %>" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Bergabung ke Grup WA
        </a>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-6">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <p class="text-sm font-semibold text-blue-800">Selanjutnya?</p>
        <p class="text-sm text-blue-700 mt-1">
          Admin akan memverifikasi bukti pembayaran Anda dalam 1x24 jam. Setelah diverifikasi, Anda akan ditambahkan ke grup WhatsApp pelatihan.
        </p>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Back link -->
  <div class="text-center">
    <a href="/trainings" class="text-sm text-brand-500 hover:text-navy-800 hover:underline transition-colors">
      &larr; Lihat Pelatihan Lainnya
    </a>
  </div>

</div>

<%- include('../layout/footer') %>
