<%- include('../layout/header', { title: 'Pendaftaran - ' + training.title }) %>

<%
  // Kategori peserta yang diizinkan untuk kategori training ini
  // (ditentukan server di registrationController.allowedCategories)
  const allowedCats = (typeof allowedCategories !== 'undefined' && allowedCategories.length)
    ? allowedCategories
    : ['umum', 'mahasiswa_uad', 'karyawan_uad']
  const catLabels = {
    'umum': 'Umum',
    'mahasiswa_uad': 'Mahasiswa UAD',
    'karyawan_uad': 'Karyawan UAD'
  }
  const showUadFields = allowedCats.includes('mahasiswa_uad') || allowedCats.includes('karyawan_uad')
%>

<div class="max-w-2xl mx-auto">
  <!-- Page Header -->
  <div class="mb-6">
    <a href="/trainings/<%= training.slug %>" class="text-brand-500 hover:underline text-sm">&larr; Kembali ke detail pelatihan</a>
    <h1 class="text-2xl font-bold text-gray-800 mt-2">Formulir Pendaftaran</h1>
    <p class="text-gray-600 mt-1">Pelatihan: <span class="font-semibold"><%= training.title %></span></p>
  </div>

  <!-- Error Messages -->
  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <div class="bg-red-50 border border-red-400 text-red-800 px-4 py-3 rounded mb-6" role="alert">
      <p class="font-semibold mb-1">Terdapat kesalahan pada formulir:</p>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <% errors.forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Registration Form -->
  <form
    action="/trainings/<%= training.slug %>/register"
    method="POST"
    enctype="multipart/form-data"
    class="bg-white shadow-md rounded-lg p-6 space-y-5"
  >
    <!-- Full Name -->
    <div>
      <label for="fullName" class="block text-sm font-medium text-gray-700 mb-1">
        Nama Lengkap <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="fullName"
        name="full_name"
        value="<%= typeof formData !== 'undefined' && formData.full_name ? formData.full_name : '' %>"
        required
        placeholder="Masukkan nama lengkap Anda"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
        Alamat Email <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
        required
        placeholder="contoh@email.com"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
    </div>

    <!-- Phone -->
    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
        Nomor Telepon <span class="text-red-500">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
        required
        placeholder="Contoh: 08123456789"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
      <p class="text-xs text-gray-500 mt-1">Minimal 10 digit.</p>
    </div>

    <!-- Asal Instansi (field baru, wajib untuk semua kategori) -->
    <div>
      <label for="institution" class="block text-sm font-medium text-gray-700 mb-1">
        Asal Instansi <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="institution"
        name="institution"
        value="<%= typeof formData !== 'undefined' && formData.institution ? formData.institution : '' %>"
        required
        placeholder="Contoh: UAD, SMK N 1 Yogyakarta, PT Sinar Abadi, dsb."
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
      <p class="text-xs text-gray-500 mt-1">Instansi / asal Anda (sekolah, kampus, perusahaan, dll.).</p>
    </div>

    <!-- Category — opsi dibatasi per kategori training (dihitung server) -->
    <div>
      <label for="categorySelect" class="block text-sm font-medium text-gray-700 mb-1">
        Kategori Peserta <span class="text-red-500">*</span>
      </label>
      <select
        id="categorySelect"
        name="category"
        required
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
      >
        <option value="" disabled <%= (typeof formData === 'undefined' || !formData.category) ? 'selected' : '' %>>-- Pilih kategori --</option>
        <% allowedCats.forEach(function(c) { %>
        <option value="<%= c %>" <%= (typeof formData !== 'undefined' && formData.category === c) ? 'selected' : '' %>><%= catLabels[c] %></option>
        <% }) %>
      </select>
      <p class="text-xs text-gray-500 mt-1">Kategori menentukan harga pendaftaran yang berlaku.</p>
    </div>

    <!-- Payment option — kategori gratis yang MEMAKAI paket/sertifikat berbayar
         (is_free_tier && cert_available). Kategori gratis MURNI
         (cert_available = 0) tidak menampilkan pilihan apa pun: selalu Rp 0.
         Bila kategori tak dikenal di tabel categories (DB lama),
         cert_available tidak ada di object → perlakukan sebagai pakai-paket
         agar perilaku lama tidak berubah. -->
    <% if (training.is_free_tier && training.cert_available !== false && certFee > 0) { %>
    <div id="paymentOptionBlock">
      <label class="block text-sm font-medium text-gray-700 mb-1" for="payGratis">
        Jenis Pembayaran <span class="text-red-500">*</span>
      </label>
      <div class="grid grid-cols-2 gap-3" id="paymentOptionGrid">
        <label class="pay-opt flex items-start gap-2 border border-gray-300 bg-white rounded-md px-3 py-2.5 cursor-pointer transition-colors">
          <input
            type="radio"
            id="payGratis"
            name="payment_option"
            value="gratis"
            <%= (typeof formData !== 'undefined' && formData.payment_option === 'gratis') ? 'checked' : (!formData || !formData.payment_option) ? 'checked' : '' %>
            class="mt-0.5 text-brand-600 focus:ring-brand-500"
          />
          <span>
            <span class="block text-sm font-semibold text-gray-800">Gratis</span>
            <span class="block text-xs text-gray-500">Rp 0 — tanpa sertifikat</span>
          </span>
        </label>
        <label class="pay-opt flex items-start gap-2 border border-gray-300 bg-white rounded-md px-3 py-2.5 cursor-pointer transition-colors">
          <input
            type="radio"
            id="paySertifikat"
            name="payment_option"
            value="sertifikat"
            <%= (typeof formData !== 'undefined' && formData.payment_option === 'sertifikat') ? 'checked' : '' %>
            class="mt-0.5 text-brand-600 focus:ring-brand-500"
          />
          <span>
            <span class="block text-sm font-semibold text-gray-800">Dengan Sertifikat</span>
            <span class="block text-xs text-gray-500"><%= fmt.format(certFee) %></span>
          </span>
        </label>
      </div>
      <p class="text-xs text-gray-500 mt-1">
        Pendaftaran gratis. Pilih <strong>Gratis</strong> untuk Rp 0, atau <strong>Dengan Sertifikat</strong> untuk
        <%= fmt.format(certFee) %> (dibayar setelah diverifikasi admin).
      </p>
    </div>
    <% } %>

    <% if (showUadFields) { %>
    <!-- UAD-specific Fields (hidden by default, shown via JS) -->
    <div id="uadFields" class="hidden space-y-4 border-t border-gray-200 pt-4">
      <p class="text-sm font-medium text-gray-700">Data Identitas UAD</p>

      <!-- NIM / NIY -->
      <div>
        <label for="identityNumber" class="block text-sm font-medium text-gray-700 mb-1">
          NIM / NIY <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="identityNumber"
          name="identity_number"
          value="<%= typeof formData !== 'undefined' && formData.identity_number ? formData.identity_number : '' %>"
          placeholder="Masukkan NIM atau NIY Anda"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
        <p class="text-xs text-gray-500 mt-1">Minimal 5 karakter.</p>
      </div>

      <!-- KTM / ID Card File Upload -->
      <div>
        <label for="identityCardProof" class="block text-sm font-medium text-gray-700 mb-1">
          KTM / ID Card <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="identityCardProof"
          name="identity_card_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Format yang diterima: JPG, JPEG, PNG, PDF. Ukuran maksimal 5MB.</p>
      </div>
    </div>
    <% } %>

    <!-- Bukti follow adtc_uad (field baru, wajib untuk semua kategori) -->
    <div>
      <label for="socialProof" class="block text-sm font-medium text-gray-700 mb-1">
        Bukti Follow <a href="https://instagram.com/adtc_uad" target="_blank" rel="noopener noreferrer" class="text-brand-500 hover:underline">adtc_uad</a> <span class="text-red-500">*</span>
      </label>
      <input
        type="file"
        id="socialProof"
        name="social_proof"
        accept=".jpg,.jpeg,.png,.pdf"
        required
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
      />
      <p class="text-xs text-gray-500 mt-1">Follow dulu akun <strong>adtc_uad</strong> di Instagram, lalu upload screenshot sebagai bukti. Format: JPG, JPEG, PNG, PDF. Ukuran maksimal 5MB.</p>
    </div>

    <!-- Syarat Promosi Kategori Gratis — hanya tampil bila is_free_tier -->
    <% if (training.is_free_tier) { %>
    <div class="space-y-4 border-t border-gray-200 pt-4">
      <p class="text-sm font-semibold text-navy-700">Syarat Promosi <span class="font-normal text-gray-500">(wajib — kategori gratis)</span></p>

      <!-- Bukti post flyer di IG story -->
      <div>
        <label for="igStoryProof" class="block text-sm font-medium text-gray-700 mb-1">
          Bukti Post Flyer di IG Story <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="igStoryProof"
          name="ig_story_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          required
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Screenshot IG Story Anda yang menampilkan flyer pelatihan ADTC. Format: JPG, JPEG, PNG, PDF. Maksimal 5MB.</p>
      </div>

      <!-- Bukti share ke 3 grup WhatsApp -->
      <div>
        <label for="waShareProof" class="block text-sm font-medium text-gray-700 mb-1">
          Bukti Share ke 3 Grup WhatsApp <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="waShareProof"
          name="wa_share_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          required
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Screenshot chat dari minimal 3 grup WhatsApp tempat Anda membagikan flyer. Format: JPG, JPEG, PNG, PDF. Maksimal 5MB.</p>
      </div>

      <!-- Link komentar di postingan IG adtc_uad -->
      <div>
        <label for="postCommentUrl" class="block text-sm font-medium text-gray-700 mb-1">
          Link Komentar di Postingan IG <a href="https://instagram.com/adtc_uad" target="_blank" rel="noopener noreferrer" class="text-brand-500 hover:underline">adtc_uad</a> <span class="text-red-500">*</span>
        </label>
        <input
          type="url"
          id="postCommentUrl"
          name="post_comment_url"
          value="<%= typeof formData !== 'undefined' && formData.post_comment_url ? formData.post_comment_url : '' %>"
          required
          placeholder="https://www.instagram.com/p/..."
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
        <p class="text-xs text-gray-500 mt-1">Komentari salah satu postingan <strong>adtc_uad</strong> di Instagram, lalu tempelkan link komentar Anda.</p>
      </div>
    </div>
    <% } %>

    <!-- Submit Button -->
    <div class="pt-2">
      <button
        type="submit"
        class="w-full bg-navy-700 hover:bg-brand-700 text-white font-semibold py-3 px-6 rounded-md transition duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
      >
        Daftar Sekarang
      </button>
    </div>
  </form>
</div>

<script src="/js/registration-form.js"></script>

<%- include('../layout/footer') %>
