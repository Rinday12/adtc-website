<%- include('../layout/header', { title: 'Pendaftaran - ' + training.title }) %>

<%
  // Kategori peserta yang diizinkan untuk kategori training ini
  // (ditentukan server di registrationController.allowedCategories)
  const allowedCats = (typeof allowedCategories !== 'undefined' && allowedCategories.length)
    ? allowedCategories
    : ['umum', 'mahasiswa_uad', 'karyawan_uad']
  // Deduplicate: karyawan_uad hidden — employees who work at UAD use
  // the same "Mahasiswa/Alumni/Bekerja di UAD" option (submit nilai mahasiswa_uad,
  // isian NIM/NIY bebas sesuai identitas mereka).
  const visibleCats = allowedCats.filter(function(c) { return c !== 'karyawan_uad' })
  const catLabels = {
    'umum': 'Umum',
    'mahasiswa_uad': 'Mahasiswa/Alumni/Bekerja di UAD'
  }
  const showUadFields = allowedCats.includes('mahasiswa_uad') || allowedCats.includes('karyawan_uad')
%>

<div class="max-w-2xl mx-auto">
  <!-- Page Header -->
  <div class="mb-6">
    <a href="/trainings/<%= training.slug %>" class="text-brand-500 hover:underline text-sm">&larr; Kembali ke detail pelatihan</a>
    <h1 class="text-2xl font-bold text-gray-800 mt-2">Formulir Pendaftaran</h1>
    <p class="text-gray-600 mt-1">Pelatihan: <span class="font-semibold"><%= training.title %></span></p>
  </div>

  <!-- Error Messages -->
  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <div class="bg-red-50 border border-red-400 text-red-800 px-4 py-3 rounded mb-6" role="alert">
      <p class="font-semibold mb-1">Terdapat kesalahan pada formulir:</p>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <% errors.forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Banner Promo (hanya untuk kategori berbayar, bila promo aktif & lebih murah) -->
  <%
    const promoNow = (function(){
      if (typeof promo === 'undefined' || !promo || !promo.is_active) return null
      const now = Date.now()
      const starts = promo.promo_starts_at ? new Date(promo.promo_starts_at).getTime() : null
      const ends = promo.promo_ends_at ? new Date(promo.promo_ends_at).getTime() : null
      if (starts !== null && now < starts) return null
      if (ends !== null && now > ends) return null
      // Harga per training (byTraining) bila ada, selain itu fallback ke
      // harga default global.
      const p = promo.byTraining && promo.byTraining[training.id] != null
        ? Number(promo.byTraining[training.id])
        : Number(promo.promo_price)
      if (isNaN(p) || p < 0) return null
      // Promo hanya relevan untuk kategori berbayar; tier gratis tak tersentuh.
      if (training.is_free_tier) return null
      const prices = [Number(training.price_general)||0, Number(training.price_student_uad)||0, Number(training.price_employee_uad)||0].filter(x => x > 0)
      const minNormal = prices.length ? Math.min.apply(null, prices) : 0
      return p < minNormal ? promo : null
    })()
    // Harga efektif untuk training ini (dipakai di banner) — per training
    // bila ada, selain itu harga default global.
    const promoDisplayPrice = promo && promo.byTraining && promo.byTraining[training.id] != null
      ? Number(promo.byTraining[training.id])
      : (promo ? Number(promo.promo_price) : 0)
  %>
  <% if (promoNow) { %>
  <div class="mb-6 rounded-xl border border-amber-300 bg-amber-50 px-5 py-4 flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-amber-500 text-lg" aria-hidden="true">&#127873;</span>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-amber-800">
        <%= promoNow.label || 'Promo' %> — Rp <%= promoDisplayPrice.toLocaleString('id-ID') %>
      </p>
      <p class="text-xs text-amber-700 mt-0.5">
        Berlaku
        <%= promoNow.promo_starts_at ? new Date(promoNow.promo_starts_at).toLocaleDateString('id-ID') : '' %>
        s.d.
        <%= promoNow.promo_ends_at ? new Date(promoNow.promo_ends_at).toLocaleDateString('id-ID') : 'tidak ditentukan' %>
        — harga ini diterapkan otomatis saat mendaftar.
      </p>
    </div>
  </div>
  <% } %>

  <!-- Registration Form -->
  <form
    action="/trainings/<%= training.slug %>/register"
    method="POST"
    enctype="multipart/form-data"
    class="bg-white shadow-md rounded-lg p-6 space-y-5"
  >
    <!-- Full Name -->
    <div>
      <label for="fullName" class="block text-sm font-medium text-gray-700 mb-1">
        Nama Lengkap <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="fullName"
        name="full_name"
        value="<%= typeof formData !== 'undefined' && formData.full_name ? formData.full_name : '' %>"
        required
        placeholder="Masukkan nama lengkap Anda"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
        Alamat Email <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
        required
        placeholder="contoh@email.com"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
    </div>

    <!-- Phone -->
    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
        Nomor Telepon <span class="text-red-500">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
        required
        placeholder="Contoh: 08123456789"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
      <p class="text-xs text-gray-500 mt-1">Minimal 10 digit.</p>
    </div>

    <!-- Category — opsi dibatasi per kategori training (dihitung server)
         Diposisikan di atas Asal Instansi karena kategori menentukan
         harga & persyaratan, jadi lebih logis dipilih duluan. -->
    <div>
      <label for="categorySelect" class="block text-sm font-medium text-gray-700 mb-1">
        Kategori Peserta <span class="text-red-500">*</span>
      </label>
      <select
        id="categorySelect"
        name="category"
        required
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
      >
        <option value="" disabled <%= (typeof formData === 'undefined' || !formData.category) ? 'selected' : '' %>>-- Pilih kategori --</option>
        <% visibleCats.forEach(function(c) { %>
        <option value="<%= c %>" <%= (typeof formData !== 'undefined' && formData.category === c) ? 'selected' : '' %>><%= catLabels[c] %></option>
        <% }) %>
      </select>
      <p class="text-xs text-gray-500 mt-1">Kategori menentukan harga pendaftaran yang berlaku.</p>
    </div>

    <!-- Asal Instansi (field baru, wajib untuk semua kategori) -->
    <div>
      <label for="institution" class="block text-sm font-medium text-gray-700 mb-1">
        Asal Instansi <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="institution"
        name="institution"
        value="<%= typeof formData !== 'undefined' && formData.institution ? formData.institution : '' %>"
        required
        placeholder="Contoh: UAD, SMK N 1 Yogyakarta, PT Sinar Abadi, dsb."
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
      />
      <p class="text-xs text-gray-500 mt-1">Instansi / asal Anda (sekolah, kampus, perusahaan, dll.).</p>
    </div>

    <% if (!training.is_free_tier) { %>
    <!-- Bukti follow adtc_uad — kategori berbayar/reguler, opsional -->
    <div>
      <label for="socialProof" class="block text-sm font-medium text-gray-700 mb-1">
        Bukti Follow <a href="https://instagram.com/adtc_uad" target="_blank" rel="noopener noreferrer" class="text-brand-500 hover:underline">adtc_uad</a>
        <span class="text-gray-400 font-normal">(opsional)</span>
      </label>
      <input
        type="file"
        id="socialProof"
        name="social_proof"
        accept=".jpg,.jpeg,.png,.pdf"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
      />
      <p class="text-xs text-gray-500 mt-1">Opsional — follow akun <strong>adtc_uad</strong> di Instagram, lalu upload screenshot sebagai bukti. Format: JPG, JPEG, PNG, PDF. Ukuran maksimal 5MB.</p>
    </div>
    <% } %>

    <!-- Payment option — kategori gratis: peserta bisa memilih Rp 0 (ikut + e-sertifikat)
         atau Paket Lengkap (Rp certFee). Ditampilkan untuk semua is_free_tier. -->
    <% if (training.is_free_tier && certFee > 0) { %>
    <div id="paymentOptionBlock">
      <label class="block text-sm font-medium text-gray-700 mb-1" for="payGratis">
        Jenis Pembayaran <span class="text-red-500">*</span>
      </label>
      <div class="grid grid-cols-2 gap-3" id="paymentOptionGrid">
        <label class="pay-opt flex items-start gap-2 border border-gray-300 bg-white rounded-md px-3 py-2.5 cursor-pointer transition-colors">
          <input
            type="radio"
            id="payGratis"
            name="payment_option"
            value="gratis"
            <%= (typeof formData !== 'undefined' && formData.payment_option === 'gratis') ? 'checked' : (!formData || !formData.payment_option) ? 'checked' : '' %>
            class="mt-0.5 text-brand-600 focus:ring-brand-500"
          />
          <span>
            <span class="block text-sm font-semibold text-gray-800">Gratis</span>
            <span class="block text-xs text-gray-500"><% if (training.cert_override === 0) { %>Rp 0 — ikut tanpa e-sertifikat<% } else { %>Rp 0 — ikut + e-sertifikat<% } %></span>
          </span>
        </label>
        <label class="pay-opt flex items-start gap-2 border border-gray-300 bg-white rounded-md px-3 py-2.5 cursor-pointer transition-colors">
          <input
            type="radio"
            id="paySertifikat"
            name="payment_option"
            value="sertifikat"
            <%= (typeof formData !== 'undefined' && formData.payment_option === 'sertifikat') ? 'checked' : '' %>
            class="mt-0.5 text-brand-600 focus:ring-brand-500"
          />
          <span>
            <span class="block text-sm font-semibold text-gray-800">Paket Lengkap</span>
            <span class="block text-xs text-gray-500"><%= fmt.format(certFee) %> — Soft File, QnA, Group Discussion, Sertifikat, Info Lowongan, Recording, Networking, Diskusi Ahli</span>
          </span>
        </label>
      </div>

      <p class="text-xs text-gray-500 mt-1">
        Pendaftaran gratis. Pilih <strong>Gratis</strong> (Rp 0<% if (training.cert_override !== 0) { %>, sudah termasuk e-sertifikat<% } else { %>, tanpa e-sertifikat — beli Paket Lengkap bila ingin<% } %>)
        atau <strong>Paket Lengkap</strong> (<%= fmt.format(certFee) %>) — dibayar setelah diverifikasi admin.
      </p>

      <!-- Perbandingan fasilitas: Gratis vs Paket Lengkap -->
      <div class="mt-3 bg-brand-50 border border-brand-200 rounded-lg p-4">
        <p class="text-xs font-semibold text-brand-800 uppercase tracking-wide mb-3">
          Perbandingan Fasilitas
        </p>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-white rounded-lg p-3 border border-gray-200">
            <p class="text-xs font-bold text-gray-700 mb-2"><% if (training.cert_override === 0) { %>Rp 0 — Gratis (tanpa e-sertifikat)<% } else { %>Rp 0 — Gratis<% } %></p>
            <ul class="space-y-1.5">
              <li class="flex items-center gap-1.5 text-xs text-gray-700">
                <svg class="w-3.5 h-3.5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Soft File Materi
              </li>
              <li class="flex items-center gap-1.5 text-xs text-gray-700">
                <svg class="w-3.5 h-3.5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                QnA Support
              </li>
              <li class="flex items-center gap-1.5 text-xs text-gray-700">
                <svg class="w-3.5 h-3.5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Group Discussion
              </li>
              <% if (training.cert_override !== 0) { %>
              <li class="flex items-center gap-1.5 text-xs text-gray-700">
                <svg class="w-3.5 h-3.5 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                E-Sertifikat
              </li>
              <% } %>
            </ul>
          </div>
          <div class="bg-white rounded-lg p-3 border border-brand-300" id="certComparisonPanel">
            <p class="text-xs font-bold text-brand-800 mb-2" id="certComparisonLabel">Rp <%= fmt.format(certFee) %> — Paket Lengkap</p>
            <ul class="space-y-1.5">
              <% ['Soft File Materi','QnA Support','Group Discussion','Sertifikat Digital','Info Lowongan Kerja','Recording Materi','Networking','Diskusi dengan Para Ahli'].forEach(function(benefit) { %>
              <li class="flex items-center gap-1.5 text-xs text-gray-700">
                <svg class="w-3.5 h-3.5 text-brand-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <%= benefit %>
              </li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (showUadFields) { %>
    <!-- UAD-specific Fields (hidden by default, shown via JS) -->
    <div id="uadFields" class="hidden space-y-4 border-t border-gray-200 pt-4">
      <p class="text-sm font-medium text-gray-700">Data Identitas UAD</p>

      <!-- NIM / NIY -->
      <div>
        <label for="identityNumber" class="block text-sm font-medium text-gray-700 mb-1">
          NIM / NIY <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="identityNumber"
          name="identity_number"
          value="<%= typeof formData !== 'undefined' && formData.identity_number ? formData.identity_number : '' %>"
          placeholder="Masukkan NIM atau NIY Anda"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
        <p class="text-xs text-gray-500 mt-1">Minimal 5 karakter.</p>
      </div>

      <!-- KTM / ID Card File Upload -->
      <div>
        <label for="identityCardProof" class="block text-sm font-medium text-gray-700 mb-1">
          KTM / ID Card <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="identityCardProof"
          name="identity_card_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Format yang diterima: JPG, JPEG, PNG, PDF. Ukuran maksimal 5MB.</p>
      </div>
    </div>
    <% } %>

    <!-- Instruksi Upload Dokumen (untuk kategori berbayar dengan training_document terisi) -->
    <% if (!training.is_free_tier && training.training_document) { %>
    <div class="border-t border-gray-200 pt-4">
      <p class="text-sm font-semibold text-gray-700 mb-2">Instruksi Upload Dokumen</p>
      <div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3">
        <p class="text-xs text-blue-800 leading-relaxed">
          1. Buka <a href="<%= training.training_document %>" target="_blank" rel="noopener noreferrer" class="underline font-medium">folder Google Drive pelatihan ini</a><br>
          2. Buat subfolder baru dengan <strong>Nama Lengkap Anda</strong> (misal: "Budi Santoso")<br>
          3. Unggah 1 file dokumen ke dalam subfolder tersebut (JPG, PNG, atau PDF; maks 5MB)<br>
          4. Pastikan file sudah terunggah SEBELUM membayar — agar tidak ada penundaan verifikasi
        </p>
        <p class="text-xs text-blue-700 mt-2">Admin akan memverifikasi file saat proses approve pembayaran.</p>
      </div>
    </div>
    <% } %>

    <!-- Persyaratan Kategori Gratis — hanya tampil bila is_free_tier
         (social_proof ikut masuk ke sini agar semua bukti di satu section)
         Elemen id="freeTierProofs" dipakai JS: disembunyikan saat radio
         "Dengan Sertifikat" dipilih (peserta berbayar tidak wajib promo). -->
    <% if (training.is_free_tier) { %>
    <div id="freeTierProofs" class="space-y-4 border-t border-gray-200 pt-4">
      <p class="text-sm font-semibold text-navy-700">Persyaratan</p>

      <!-- Bukti follow adtc_uad -->
      <div>
        <label for="socialProofFree" class="block text-sm font-medium text-gray-700 mb-1">
          Bukti Follow <a href="https://instagram.com/adtc_uad" target="_blank" rel="noopener noreferrer" class="text-brand-500 hover:underline">adtc_uad</a> <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="socialProofFree"
          name="social_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          required
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Follow dulu akun <strong>adtc_uad</strong> di Instagram, lalu upload screenshot sebagai bukti.</p>
      </div>

      <!-- Bukti post flyer di IG story -->
      <div>
        <label for="igStoryProof" class="block text-sm font-medium text-gray-700 mb-1">
          Bukti Post Flyer di IG Story <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="igStoryProof"
          name="ig_story_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          required
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Screenshot IG Story Anda yang menampilkan flyer pelatihan ADTC.</p>
      </div>

      <!-- Bukti share ke 3 grup WhatsApp -->
      <div>
        <label for="waShareProof" class="block text-sm font-medium text-gray-700 mb-1">
          Bukti Share ke 3 Grup WhatsApp <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="waShareProof"
          name="wa_share_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          required
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Screenshot chat dari minimal 3 grup WhatsApp tempat Anda membagikan flyer.</p>
      </div>

      <!-- Bukti komentar di postingan IG adtc_uad -->
      <div>
        <label for="igCommentProof" class="block text-sm font-medium text-gray-700 mb-1">
          Bukti Komentar di Postingan IG <a href="https://instagram.com/adtc_uad" target="_blank" rel="noopener noreferrer" class="text-brand-500 hover:underline">adtc_uad</a> <span class="text-red-500">*</span>
        </label>
        <input
          type="file"
          id="igCommentProof"
          name="ig_comment_proof"
          accept=".jpg,.jpeg,.png,.pdf"
          required
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white"
        />
        <p class="text-xs text-gray-500 mt-1">Komentari salah satu postingan <strong>adtc_uad</strong>, lalu upload screenshot komentar Anda.</p>
      </div>
    </div>
    <% } %>

    <!-- Submit Button -->
    <div class="pt-2">
      <button
        type="submit"
        class="w-full bg-navy-700 hover:bg-brand-700 text-white font-semibold py-3 px-6 rounded-md transition duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
      >
        Daftar Sekarang
      </button>
    </div>
  </form>
</div>

<script src="/js/registration-form.js"></script>

<%- include('../layout/footer') %>
