<%- include('../layout/header') %>

<div class="max-w-2xl mx-auto">

  <!-- Success Banner -->
  <div class="bg-green-50 border border-green-200 rounded-xl p-6 mb-6 flex items-start gap-4">
    <div class="shrink-0 w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
      <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <div>
      <h1 class="text-2xl font-bold text-green-800">Pendaftaran Berhasil!</h1>
      <p class="text-green-700 mt-1 text-sm">
        Terima kasih telah mendaftar. Silakan selesaikan pembayaran sesuai instruksi di bawah.
      </p>
    </div>
  </div>

  <!-- Registration Summary -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-6">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-800">Ringkasan Pendaftaran</h2>
    </div>
    <dl class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Peserta</dt>
        <dd class="text-sm font-medium text-gray-900 text-right"><%= registration.full_name %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Program</dt>
        <dd class="text-sm font-medium text-gray-900 text-right"><%= registration.training_title %></dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Kode Referensi</dt>
        <dd class="text-sm font-mono font-semibold text-brand-600 text-right bg-brand-50 px-2 py-0.5 rounded border border-brand-200">
          <%= registration.reference_code %>
        </dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Total Pembayaran</dt>
        <dd class="text-base font-bold text-navy-700 text-right">
          <%= fmt.format(registration.final_price) %>
        </dd>
      </div>
      <div class="px-6 py-4 flex justify-between gap-4">
        <dt class="text-sm text-gray-500 shrink-0">Status</dt>
        <dd class="text-right">
          <%
            const statusConfig = {
              pending:            { label: 'Menunggu Persetujuan', cls: 'bg-yellow-100 text-yellow-800 border-yellow-200' },
              approved:           { label: 'Disetujui — Silakan Bayar', cls: 'bg-blue-100 text-blue-800 border-blue-200' },
              payment_uploaded:   { label: 'Bukti Terkirim', cls: 'bg-orange-100 text-orange-800 border-orange-200' },
              verified:           { label: 'Terverifikasi', cls: 'bg-green-100 text-green-800 border-green-200' },
              rejected:           { label: 'Ditolak', cls: 'bg-red-100 text-red-800 border-red-200' }
            }
            const sc = statusConfig[registration.status] || { label: registration.status, cls: 'bg-gray-100 text-gray-700 border-gray-200' }
          %>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold border <%= sc.cls %>">
            <%= sc.label %>
          </span>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Rejection reason (if rejected) -->
  <% if (registration.status === 'rejected' && registration.rejection_reason) { %>
  <div class="bg-red-50 border border-red-200 rounded-xl p-5 mb-6">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-red-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
      </svg>
      <div>
        <p class="text-sm font-semibold text-red-800">Alasan Penolakan</p>
        <p class="text-sm text-red-700 mt-1"><%= registration.rejection_reason %></p>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Payment instruction note -->
  <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-6">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <div>
        <p class="text-sm font-semibold text-blue-800">Informasi Pembayaran</p>
        <p class="text-sm text-blue-700 mt-1">
          Nomor rekening dan instruksi pembayaran akan dikirimkan ke email Anda (<strong><%= registration.email %></strong>).
          Silakan cek inbox atau folder spam.
        </p>
      </div>
    </div>
  </div>

  <!-- Action CTA based on status -->
  <% if (registration.status === 'approved') { %>
    <!-- Show upload payment proof CTA -->
    <div class="bg-white rounded-xl border border-blue-200 shadow-sm mb-6 p-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-2">Lanjutkan Pembayaran</h2>
      <p class="text-sm text-gray-600 mb-4">
        Pendaftaran Anda telah disetujui. Silakan transfer ke rekening di atas, lalu unggah bukti pembayaran Anda.
      </p>
      <a
        href="/registrations/<%= registration.id %>/payment"
        class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold px-6 py-3 rounded-lg transition-colors shadow-sm"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        Upload Bukti Pembayaran
      </a>
    </div>
  <% } else if (registration.status === 'pending') { %>
    <!-- Waiting for approval info -->
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-brand-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-blue-800">Menunggu Persetujuan Admin</p>
          <p class="text-sm text-blue-700 mt-1">
            Data pendaftaran Anda sedang diperiksa oleh admin. Setelah disetujui, Anda akan menerima email berisi instruksi pembayaran dan link untuk mengunggah bukti transfer.
          </p>
        </div>
      </div>
    </div>
  <% } else if (registration.status === 'verified') { %>
    <!-- Verified success -->
    <div class="bg-green-50 border border-green-200 rounded-xl p-5 mb-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-green-800">Pembayaran Terverifikasi!</p>
          <p class="text-sm text-green-700 mt-1">
            Terima kasih telah membayar. Anda telah resmi terdaftar sebagai peserta pelatihan ini.
            <% if (whatsappUrl) { %>
              <a href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer" class="font-semibold underline mt-1 inline-block">Hubungi admin via WhatsApp</a>
            <% } %>
          </p>
        </div>
      </div>
    </div>
  <% } else if (registration.status === 'payment_uploaded') { %>
    <!-- Waiting for admin verification -->
    <div class="bg-orange-50 border border-orange-200 rounded-xl p-5 mb-6">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-orange-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-orange-800">Menunggu Verifikasi Admin</p>
          <p class="text-sm text-orange-700 mt-1">
            Bukti pembayaran Anda sedang diverifikasi oleh admin. Anda akan menerima pemberitahuan melalui WhatsApp atau email.
          </p>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Back Link -->
  <div class="text-center">
    <a href="/trainings" class="text-sm text-brand-500 hover:text-navy-800 hover:underline transition-colors">
      &larr; Lihat Pelatihan Lainnya
    </a>
  </div>

</div>

<%- include('../layout/footer') %>
