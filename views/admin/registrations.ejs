<%- include('../layout/header', { title, adminUser, currentPath }) %>
<%- include('./layout/sidebar', { adminUser, currentPath }) %>

<!-- Tombol buka sidebar di layar mobile (sidebar tersembunyi di < lg) -->
<button
  type="button"
  onclick="toggleSidebar()"
  class="lg:hidden fixed top-4 left-4 z-50 w-10 h-10 bg-navy-800 text-white rounded-lg shadow-lg flex items-center justify-center"
  aria-label="Buka menu"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
  </svg>
</button>

<!-- Main content -->
<div class="lg:pl-64">
<div class="max-w-6xl mx-auto px-4 py-6 lg:px-6">

  <!-- Page Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Daftar Peserta</h1>
      <p class="text-gray-500 text-sm mt-1">Pendaftaran, kelola status, dan verifikasi peserta pelatihan ADTC</p>
    </div>
    <button
      type="button"
      onclick="window.location.reload()"
      class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-green-700 transition-colors border border-gray-300 hover:border-green-400 rounded-lg px-4 py-2"
      title="Muat ulang data"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      Refresh
    </button>
  </div>

  <!-- Status filter chips -->
  <div class="flex flex-wrap gap-2 mb-4">
    <%
      const chipDefs = [
        { key: 'all',              label: 'Semua' },
        { key: 'pending',          label: 'Menunggu' },
        { key: 'payment_uploaded', label: 'Menunggu Verifikasi' },
        { key: 'approved',         label: 'Disetujui' },
        { key: 'verified',         label: 'Terverifikasi' },
        { key: 'rejected',         label: 'Ditolak' }
      ]
      const chipCounts = {
        all:              stats ? (stats.total || 0) : 0,
        pending:          stats ? (stats.pending || 0) : 0,
        payment_uploaded: stats ? (stats.payment_uploaded || 0) : 0,
        approved:         stats ? (stats.approved || 0) : 0,
        verified:         stats ? (stats.verified || 0) : 0,
        rejected:         stats ? (stats.rejected || 0) : 0
      }
    %>
    <% chipDefs.forEach(function(chip) { %>
      <a
        href="/admin/registrations?status=<%= chip.key %>"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium border transition-colors
          <%= activeFilter === chip.key
            ? 'bg-navy-700 border-navy-700 text-white shadow-sm'
            : 'bg-white border-gray-200 text-gray-600 hover:border-gray-300 hover:bg-gray-50' %>"
      >
        <span><%= chip.label %></span>
        <span class="text-xs px-1.5 py-0.5 rounded-full
          <%= activeFilter === chip.key ? 'bg-white/20 text-white' : 'bg-gray-100 text-gray-500' %>">
          <%= chipCounts[chip.key] %>
        </span>
      </a>
    <% }) %>
  </div>

  <!-- Search & Filter -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 mb-6">
    <form method="GET" action="/admin/registrations" class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-3">
      <input type="hidden" name="status" value="<%= activeFilter %>">

      <!-- Name Search -->
      <div class="relative">
        <input type="text" name="search" value="<%= filters.search %>" placeholder="Cari nama peserta..."
          class="w-full rounded-lg border-gray-300 pl-10 text-sm focus:border-brand-500 focus:ring-brand-500">
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>

      <!-- Training Search -->
      <div class="relative">
        <input type="text" name="training_search" value="<%= filters.training_search %>" placeholder="Cari jenis/nama pelatihan..."
          class="w-full rounded-lg border-gray-300 pl-10 text-sm focus:border-brand-500 focus:ring-brand-500">
        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </div>

      <!-- Buttons -->
      <div class="flex gap-2">
        <button type="submit" class="bg-navy-700 hover:bg-navy-800 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
          Terapkan
        </button>
        <a href="/admin/registrations" class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800 border border-gray-300 rounded-lg transition-colors">
          Reset
        </a>
      </div>
    </form>
  </div>

  <!-- Registrations Table -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <% if (registrations && registrations.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left min-w-[720px]">
          <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="px-4 py-3 font-semibold">Peserta</th>
              <th class="px-4 py-3 font-semibold">Pelatihan</th>
              <th class="px-4 py-3 font-semibold">Kategori</th>
              <th class="px-4 py-3 font-semibold text-right">Tagihan</th>
              <th class="px-4 py-3 font-semibold">Status</th>
              <th class="px-4 py-3 font-semibold">Tanggal</th>
              <th class="px-4 py-3 font-semibold text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% registrations.forEach(function(reg) { %>
              <tr class="hover:bg-gray-50 transition-colors">

                <!-- Peserta: avatar + nama + kode ref -->
                <td class="px-4 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
                      <span class="text-sm font-bold text-gray-500">
                        <%= reg.full_name ? reg.full_name.charAt(0).toUpperCase() : '?' %>
                      </span>
                    </div>
                    <div class="min-w-0">
                      <p class="font-medium text-gray-900 truncate max-w-[180px]" title="<%= reg.full_name %>"><%= reg.full_name %></p>
                      <span class="font-mono text-xs text-brand-600" title="Gunakan kode ini saat transfer">
                        <%= reg.reference_code %>
                      </span>
                    </div>
                  </div>
                </td>

                <!-- Nama Training -->
                <td class="px-4 py-4 text-gray-700 max-w-[200px]">
                  <span class="block truncate font-medium" title="<%= reg.training_title %>"><%= reg.training_title %></span>
                </td>

                <!-- Kategori -->
                <td class="px-4 py-4 text-gray-700">
                  <%
                    const categoryLabels = {
                      'umum':          'Umum',
                      'mahasiswa_uad': 'Mahasiswa',
                      'karyawan_uad':  'Karyawan'
                    }
                  %>
                  <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600 font-medium">
                    <%= categoryLabels[reg.category] || reg.category %>
                  </span>
                </td>

                <!-- Final Price -->
                <td class="px-4 py-4 font-medium text-navy-700 whitespace-nowrap text-right">
                  Rp <%= Number(reg.final_price || 0).toLocaleString('id-ID') %>
                </td>

                <!-- Status Badge -->
                <td class="px-4 py-4">
                  <%
                    const statusConfig = {
                      pending:            { label: 'Menunggu',             cls: 'bg-yellow-50 text-yellow-700 border-yellow-200' },
                      approved:           { label: 'Disetujui',            cls: 'bg-blue-50 text-blue-700 border-blue-200' },
                      payment_uploaded:   { label: 'Menunggu Verifikasi',  cls: 'bg-orange-50 text-orange-700 border-orange-200' },
                      verified:           { label: 'Terverifikasi',        cls: 'bg-green-50 text-green-700 border-green-200' },
                      rejected:           { label: 'Ditolak',             cls: 'bg-red-50 text-red-700 border-red-200' }
                    }
                    const sc = statusConfig[reg.status] || { label: reg.status, cls: 'bg-gray-100 text-gray-700 border-gray-200' }
                  %>
                  <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium border <%= sc.cls %> whitespace-nowrap">
                    <%= sc.label %>
                  </span>
                </td>

                <!-- Tanggal Daftar -->
                <td class="px-4 py-4 text-gray-500 whitespace-nowrap">
                  <%= new Date(reg.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>

                <!-- Action: ikon + menu konteks per status -->
                <td class="px-4 py-4">
                  <div class="flex items-center justify-end gap-1">

                    <%
                      const identityCardUrl = reg.identity_card_proof ? '/' + reg.identity_card_proof.replace(/\\/g, '/') : null;
                    %>

                    <!-- Detail -->
                    <a href="/admin/registrations/<%= reg.id %>"
                       class="p-2 rounded-lg text-gray-500 hover:text-navy-700 hover:bg-gray-100 transition-colors"
                       title="Lihat detail" aria-label="Lihat detail">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>

                    <% if (reg.status === 'pending') { %>
                      <a
                        href="/admin/registrations/<%= reg.id %>#tindakan"
                        class="p-2 rounded-lg text-green-600 hover:bg-green-50 transition-colors"
                        title="Approve (buka detail)" aria-label="Approve, buka halaman detail">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                      </a>
                      <button type="button" onclick="toggleRejectForm(<%= reg.id %>)"
                        class="p-2 rounded-lg text-red-500 hover:bg-red-50 transition-colors"
                        title="Tolak" aria-label="Tolak">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                      </button>
                    <% } else if (reg.status === 'payment_uploaded') { %>
                      <form method="POST" action="/admin/registrations/<%= reg.id %>/verify"
                            onsubmit="return confirm('Verifikasi pembayaran <%= reg.full_name %>?')" class="inline">
                        <button type="submit"
                          class="p-2 rounded-lg text-green-600 hover:bg-green-50 transition-colors"
                          title="Verifikasi pembayaran" aria-label="Verifikasi pembayaran">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                        </button>
                      </form>
                      <button type="button" onclick="toggleRejectForm(<%= reg.id %>)"
                        class="p-2 rounded-lg text-red-500 hover:bg-red-50 transition-colors"
                        title="Tolak bukti" aria-label="Tolak bukti">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                      </button>
                    <% } %>

                    <% if (reg.status !== 'rejected') { %>
                      <button onclick="toggleDeleteForm(<%= reg.id %>)"
                        class="p-2 rounded-lg text-red-400 hover:bg-red-50 transition-colors"
                        title="Hapus & keluarkan" aria-label="Hapus dan keluarkan peserta">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4V6a1 1 0 011-1h2a1 1 0 011 1v4M9 7h6"/>
                        </svg>
                      </button>
                    <% } %>
                  </div>

                  <!-- Reject form inline -->
                  <div id="reject-form-inline-<%= reg.id %>" class="hidden mt-3 p-3 bg-red-50 border border-red-200 rounded-lg">
                    <p class="text-xs text-red-700 mb-2 font-medium">Alasan penolakan <span class="font-normal">(opsional)</span>:</p>
                    <form method="POST" action="/admin/registrations/<%= reg.id %>/<%= reg.status === 'pending' ? 'reject' : 'reject-payment' %>" class="flex flex-col gap-2">
                      <input type="text" name="rejection_reason" placeholder="Contoh: Bukti tidak jelas" class="text-xs border border-red-300 rounded-lg px-3 py-2">
                      <div class="flex gap-2">
                        <button type="submit" class="text-xs bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700">Konfirmasi</button>
                        <button type="button" onclick="toggleRejectForm(<%= reg.id %>)" class="text-xs bg-white text-gray-700 border border-gray-300 px-3 py-2 rounded-lg hover:bg-gray-50">Batal</button>
                      </div>
                    </form>
                  </div>

                  <!-- Delete form inline -->
                  <div id="delete-form-inline-<%= reg.id %>" class="hidden mt-3 p-3 bg-red-50 border border-red-200 rounded-lg">
                    <p class="text-xs text-red-700 mb-2">
                      <strong>Peringatan:</strong> penghapusan permanen — record peserta dihapus dari database dan kuota slot dibuka kembali.
                    </p>
                    <p class="text-xs text-red-700 mb-2">Alasan penghapusan:</p>
                    <form method="POST" action="/admin/registrations/<%= reg.id %>/delete" class="flex flex-col gap-2">
                      <textarea name="rejection_reason" rows="2" placeholder="Contoh: Peserta minta refund" class="text-xs border border-red-300 rounded-lg px-3 py-2 resize-none"></textarea>
                      <div class="flex gap-2">
                        <button type="submit" class="text-xs bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700">Konfirmasi Hapus</button>
                        <button type="button" onclick="toggleDeleteForm(<%= reg.id %>)" class="text-xs bg-white text-gray-700 border border-gray-300 px-3 py-2 rounded-lg hover:bg-gray-50">Batal</button>
                      </div>
                    </form>
                  </div>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Row count summary -->
      <div class="px-4 py-3 bg-gray-50 border-t border-gray-200 text-xs text-gray-500 flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>Menampilkan <span class="font-medium text-gray-700"><%= registrations.length %></span> pendaftaran</span>
        <% if (filters.search || filters.training_search || activeFilter !== 'all') { %>
          <a href="/admin/registrations" class="ml-auto text-brand-600 hover:underline">Hapus filter</a>
        <% } %>
      </div>

    <% } else { %>
      <!-- Empty State -->
      <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
        <svg class="w-14 h-14 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-gray-500 font-medium">
          <% if (activeFilter !== 'all' || filters.search || filters.training_search) { %>
            Tidak ada pendaftaran yang cocok dengan filter.
          <% } else { %>
            Belum ada pendaftaran masuk.
          <% } %>
        </p>
        <% if (filters.search || filters.training_search || activeFilter !== 'all') { %>
          <a href="/admin/registrations" class="mt-3 text-sm text-brand-500 hover:underline">Tampilkan semua</a>
        <% } %>
      </div>
    <% } %>
  </div>

<script>
  function toggleRejectForm(id) {
    const form = document.getElementById('reject-form-inline-' + id);
    const delForm = document.getElementById('delete-form-inline-' + id);
    if (form) {
      form.classList.toggle('hidden');
      // Tutup form delete kalau terbuka
      if (delForm && !delForm.classList.contains('hidden')) delForm.classList.add('hidden');
    }
  }

  function toggleDeleteForm(id) {
    const form = document.getElementById('delete-form-inline-' + id);
    const rejForm = document.getElementById('reject-form-inline-' + id);
    if (form) {
      form.classList.toggle('hidden');
      // Tutup form reject kalau terbuka
      if (rejForm && !rejForm.classList.contains('hidden')) rejForm.classList.add('hidden');
    }
  }

  // Modal approve sudah ditiadakan — approve sekarang selalu lewat halaman detail
  // (satu jalur, dengan KTM checkbox & validasi). Ikon ✓ di tabel hanya
  // mengarah ke /admin/registrations/<id>#tindakan.
</script>

</div>
</div>

<%- include('./layout/admin-footer') %>
