<%- include('../../layout/header', { title, adminUser, currentPath }) %>
<%- include('../layout/sidebar', { adminUser, currentPath }) %>

<!-- Tombol buka sidebar di layar mobile -->
<button
  type="button"
  onclick="toggleSidebar()"
  class="lg:hidden fixed top-4 left-4 z-50 w-10 h-10 bg-navy-800 text-white rounded-lg shadow-lg flex items-center justify-center"
  aria-label="Buka menu"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
  </svg>
</button>

<!-- Main content — di-offset agar tidak tertutup sidebar di desktop -->
<div class="lg:pl-64">
<div class="max-w-2xl mx-auto px-4 py-6 lg:px-6">

  <!-- Page Header -->
  <div class="flex items-center gap-3 mb-6">
    <a href="/admin/trainings" class="text-brand-500 hover:text-navy-800 text-sm transition-colors">&larr; Kembali</a>
    <h1 class="text-xl font-bold text-gray-800"><%= title %></h1>
  </div>

  <!-- Form -->
  <form method="POST" action="<%= isEdit ? `/admin/trainings/${training.id}/update` : '/admin/trainings' %>" enctype="multipart/form-data" class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-base font-semibold text-gray-800">Informasi Dasar</h2>
    </div>
    <div class="px-6 py-5 space-y-4">

      <% if (errors && errors.length > 0) { %>
        <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-sm text-red-700">
          <% errors.forEach(function(e) { %><p><%= e %></p><% }) %>
        </div>
      <% } %>

      <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Judul Pelatihan <span class="text-red-500">*</span></label>
        <input type="text" id="title" name="title" value="<%= isEdit ? (training?.title || '') : '' %>" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" placeholder="Contoh: Basic Python Programming">
      </div>

      <div>
        <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Kategori <span class="text-red-500">*</span></label>
        <%
          const catList    = (typeof categories !== 'undefined' && categories) ? categories : []
          const currentCat = isEdit ? (training?.category || '') : ''
          const catExists  = catList.some(function(c){ return c.name === currentCat })
        %>

        <% if (catList.length > 0) { %>
          <!-- Dropdown kategori terdaftar + opsi "Buat kategori baru" -->
          <select id="category" name="category"
                  class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500">
            <% catList.forEach(function(c) { %>
              <%
                // Label tier: kategori gratis murni (cert_available=0) dan
                // gratis-dengan-paket dibedakan agar admin tahu konsekuensinya.
                var freeLabel = !c.is_free_tier ? ''
                  : (c.cert_available === 0) ? '  (full free — tanpa paket)' : '  (gratis + paket komplit berbayar)'
              %>
              <option value="<%= c.name %>" data-free="<%= c.is_free_tier ? 1 : 0 %>" data-certavail="<%= c.cert_available === 0 ? 0 : 1 %>" <%= currentCat === c.name ? 'selected' : '' %>>
                <%= c.name %><%= freeLabel %>
              </option>
            <% }) %>
            <option value="__new__" <%= (currentCat && !catExists) ? 'selected' : '' %>&#43; Buat kategori baru…</option>
          </select>

          <!-- Input teks, hanya aktif bila memilih "Buat kategori baru" -->
          <div id="custom-category-wrap" class="mt-2 <%= (currentCat && !catExists) ? '' : 'hidden' %>">
            <input
              type="text"
              id="category-custom"
              name="category"
              value="<%= currentCat && !catExists ? currentCat : '' %>"
              class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500"
              placeholder="Ketik nama kategori baru"
            >
            <label class="flex items-center gap-2 mt-2 cursor-pointer">
              <input
                type="checkbox"
                id="new_cat_is_free"
                name="new_cat_is_free"
                class="rounded border-gray-300 text-brand-600 focus:ring-brand-500"
              >
              <span class="text-sm text-gray-700">
                Tandai kategori ini <strong>gratis</strong>
                <span class="block text-xs text-gray-400">
                  Peserta membayar Rp 0; hanya membayar <%= certFeeFmt || 'Rp 0' %> bila memilih sertifikat.
                </span>
              </span>
            </label>
            <p class="text-xs text-gray-400 mt-1">
              Kategori dibuat otomatis saat disimpan, atau kelola lewat
              <a href="/admin/categories/create" class="text-brand-500 underline">Halaman Kategori</a>.
            </p>
          </div>

          <script>
            (function(){
              var sel    = document.getElementById('category')
              var wrap   = document.getElementById('custom-category-wrap')
              var custom = document.getElementById('category-custom')
              var freeCb = document.getElementById('new_cat_is_free')
              var banner = document.getElementById('freeTierBanner')
              if (!sel || !wrap || !custom) return

              var pureBanner = document.getElementById('freePureBanner')
              var priceGrid  = document.getElementById('priceGrid')

              // Kategori gratis → 3 kolom harga dinonaktifkan (server menyimpan
              // 0). Hanya input numerik di tiap sel data-price-field yang
              // disentuh; tanda wajib (*) disembunyikan agar tak membingungkan.
              function setPricesDisabled(disabled){
                if (!priceGrid) return
                priceGrid.querySelectorAll('div[data-price-field]').forEach(function(cell){
                  var input = cell.querySelector('input')
                  var mark  = cell.querySelector('.req-mark')
                  if (input){
                    input.disabled = disabled
                    input.classList.toggle('bg-gray-50', disabled)
                    input.classList.toggle('text-gray-400', disabled)
                  }
                  if (mark) mark.style.visibility = disabled ? 'hidden' : 'visible'
                })
              }

              // Banner ada dua (paket vs full-free). Untuk kategori terdaftar,
              // flag-nya sudah di-option (data-free / data-certavail). Untuk
              // "__new__", admin memutuskan sendiri: checkbox new_cat_is_free.
              // Checkbox baru (belum ada "full free" di form training) selalu
              // menghasilkan varian "paket" — full-free hanya via /admin/categories.
              function updateBanner(){
                var opt = sel.options[sel.selectedIndex]
                var showPaket, showPure
                if (sel.value === '__new__') {
                  var isNewFree = freeCb && freeCb.checked
                  showPaket = isNewFree
                  showPure  = false
                } else {
                  showPaket = opt && opt.dataset.free === '1' && opt.dataset.certavail !== '0'
                  showPure  = opt && opt.dataset.free === '1' && opt.dataset.certavail === '0'
                }
                if (banner) banner.classList.toggle('hidden', !showPaket)
                if (pureBanner) pureBanner.classList.toggle('hidden', !showPure)
                setPricesDisabled(showPaket || showPure)
              }

              function sync(){
                var isNew = (sel.value === '__new__')
                wrap.classList.toggle('hidden', !isNew)
                // Hanya SATU field bernama "category" yang boleh ter-submit
                // pada satu saat:
                if (isNew) { sel.removeAttribute('name'); if (custom.name !== 'category') custom.setAttribute('name','category') }
                else       { sel.setAttribute('name','category'); if (custom.name === 'category') custom.removeAttribute('name') }
                updateBanner()
              }
              sel.addEventListener('change', function(){
                sync()
                if (sel.value !== '__new__') custom.value = ''
              })
              if (freeCb) freeCb.addEventListener('change', updateBanner)
              sync()
            })()
          </script>
        <% } else { %>
          <!-- Belum ada kategori: input teks langsung (auto-create saat simpan) -->
          <input
            type="text"
            id="category"
            name="category"
            value="<%= currentCat %>"
            class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500"
            placeholder="Contoh: Konsultan / In-house training"
          >
          <label class="flex items-center gap-2 mt-2 cursor-pointer">
            <input
              type="checkbox"
              id="new_cat_is_free"
              name="new_cat_is_free"
              class="rounded border-gray-300 text-brand-600 focus:ring-brand-500"
            >
            <span class="text-sm text-gray-700">
              Tandai kategori ini <strong>gratis</strong>
              <span class="block text-xs text-gray-400">
                Peserta membayar Rp 0; hanya membayar <%= certFeeFmt || 'Rp 0' %> bila memilih sertifikat.
              </span>
            </span>
          </label>
          <p class="text-xs text-gray-400 mt-1">
            Belum ada kategori terdaftar. Nama yang diketik akan dibuat otomatis.
            Aturlagi lewat <a href="/admin/categories/create" class="text-brand-500 underline">Halaman Kategori</a>.
          </p>
          <script>
            // Cabang input teks: checkbox menyalakan banner varian "paket"
            // (kategori baru dari form training selalu tipe gratis-dengan-paket)
            // + menonaktifkan 3 kolom harga saat gratis.
            (function(){
              var cb = document.getElementById('new_cat_is_free')
              var banner = document.getElementById('freeTierBanner')
              var pure = document.getElementById('freePureBanner')
              var grid = document.getElementById('priceGrid')
              if (!cb) return
              cb.addEventListener('change', function(){
                if (banner) banner.classList.toggle('hidden', !cb.checked)
                if (pure) pure.classList.add('hidden')
                if (grid){
                  grid.querySelectorAll('div[data-price-field]').forEach(function(cell){
                    var input = cell.querySelector('input')
                    var mark  = cell.querySelector('.req-mark')
                    if (input){
                      input.disabled = cb.checked
                      input.classList.toggle('bg-gray-50', cb.checked)
                      input.classList.toggle('text-gray-400', cb.checked)
                    }
                    if (mark) mark.style.visibility = cb.checked ? 'hidden' : 'visible'
                  })
                }
              })
            })()
          </script>
        <% } %>
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Deskripsi</label>
        <textarea id="description" name="description" rows="3" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" placeholder="Deskripsi pelatihan (opsional)"><%= isEdit ? (training?.description || '') : '' %></textarea>
      </div>

      <div>
        <label for="whatsapp_group_link" class="block text-sm font-medium text-gray-700 mb-1">Link Grup WhatsApp Peserta</label>
        <input type="url" id="whatsapp_group_link" name="whatsapp_group_link" value="<%= isEdit ? (training?.whatsapp_group_link || '') : '' %>" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500" placeholder="https://chat.whatsapp.com/XXXXXX">
        <p class="text-xs text-gray-400 mt-1">Opsional. Link invite grup WA khusus pelatihan ini akan ditampilkan ke peserta setelah pembayaran diverifikasi.</p>
      </div>

      <div>
        <label for="training_cover" class="block text-sm font-medium text-gray-700 mb-1">Gambar Cover (opsional)</label>
        <input type="file" id="training_cover" name="training_cover" accept=".jpg,.jpeg,.png,.webp" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-navy-50 file:text-navy-700 hover:file:bg-navy-100">
        <% if (isEdit && training?.cover_image) { %>
          <p class="text-xs text-gray-400 mt-1">
            Gambar saat ini: <a href="/<%= training.cover_image %>" target="_blank" class="text-brand-500 underline">Lihat</a>
            <span class="ml-2">Ganti dengan upload baru.</span>
          </p>
        <% } %>
      </div>

    </div>

    <div class="px-6 py-4 border-t border-gray-100">
      <h2 class="text-base font-semibold text-gray-800 mb-4">Harga & Kuota</h2>

      <%
        // Banner "kategori gratis" — dihitung saat server render untuk kategori
        // terdaftar yang terpilih; untuk opsi "__new__"/input teks, JS
        // menampilkannya dinamis saat checkbox gratis dicentang.
        // Dua varian: pakai-paket (cert_available=1) vs full free (cert_available=0).
        var selCatNow = catList.filter(function(c){ return c.name === currentCat })[0]
        var bannerPaketNow = selCatNow && selCatNow.is_free_tier && selCatNow.cert_available !== 0
        var bannerPureNow  = selCatNow && selCatNow.is_free_tier && selCatNow.cert_available === 0
      %>
      <div id="freeTierBanner" class="mb-4 bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-800 <%= bannerPaketNow ? '' : 'hidden' %>">
        <p class="font-semibold">Kategori bertipe gratis (ikut Rp 0, ada paket komplit berbayar)</p>
        <p class="mt-1 text-green-700">
          Peserta tidak dipungut biaya untuk ikut (<strong>Rp 0</strong>), namun boleh
          membeli paket komplit (sertifikat, materi, dll.) sebesar
          <strong><%= certFeeFmt || 'Rp 0' %></strong> yang diverifikasi admin.
          Kolom harga di bawah <strong>dinonaktifkan otomatis</strong> — sistem
          menyimpannya sebagai 0; yang terpakai adalah tier kategorinya.
        </p>
      </div>
      <div id="freePureBanner" class="mb-4 bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-800 <%= bannerPureNow ? '' : 'hidden' %>">
        <p class="font-semibold">Kategori FULL FREE (gratis murni)</p>
        <p class="mt-1 text-green-700">
          Peserta selalu membayar <strong>Rp 0 total</strong> — form pendaftaran
          TIDAK menampilkan opsi paket/sertifikat berbayar. Kolom harga di
          bawah <strong>dinonaktifkan otomatis</strong> dan disimpan sebagai 0.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4" id="priceGrid">
        <div data-price-field>
          <label for="price_general" class="block text-sm font-medium text-gray-700 mb-1">Harga Umum (Rp) <span class="text-red-500 req-mark">*</span></label>
          <input type="number" id="price_general" name="price_general" value="<%= isEdit ? (training?.price_general || '') : '' %>" min="0" <%= (bannerPaketNow || bannerPureNow) ? 'disabled' : '' %> class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 <%= (bannerPaketNow || bannerPureNow) ? 'bg-gray-50 text-gray-400' : '' %>">
        </div>
        <div data-price-field>
          <label for="price_student_uad" class="block text-sm font-medium text-gray-700 mb-1">Harga Mahasiswa UAD (Rp) <span class="text-red-500 req-mark">*</span></label>
          <input type="number" id="price_student_uad" name="price_student_uad" value="<%= isEdit ? (training?.price_student_uad || '') : '' %>" min="0" <%= (bannerPaketNow || bannerPureNow) ? 'disabled' : '' %> class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 <%= (bannerPaketNow || bannerPureNow) ? 'bg-gray-50 text-gray-400' : '' %>">
        </div>
        <div data-price-field>
          <label for="price_employee_uad" class="block text-sm font-medium text-gray-700 mb-1">Harga Karyawan UAD (Rp) <span class="text-red-500 req-mark">*</span></label>
          <input type="number" id="price_employee_uad" name="price_employee_uad" value="<%= isEdit ? (training?.price_employee_uad || '') : '' %>" min="0" <%= (bannerPaketNow || bannerPureNow) ? 'disabled' : '' %> class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500 <%= (bannerPaketNow || bannerPureNow) ? 'bg-gray-50 text-gray-400' : '' %>">
        </div>
        <div>
          <label for="quota" class="block text-sm font-medium text-gray-700 mb-1">Kuota Peserta <span class="text-red-500">*</span></label>
          <input type="number" id="quota" name="quota" value="<%= isEdit ? (training?.quota || '') : '' %>" min="1" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500">
        </div>
      </div>
    </div>

    <div class="px-6 py-4 border-t border-gray-100">
      <h2 class="text-base font-semibold text-gray-800 mb-4">Jadwal & Status</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="start_date" class="block text-sm font-medium text-gray-700 mb-1">Tanggal Mulai</label>
          <input type="date" id="start_date" name="start_date" value="<%= isEdit ? (training?.start_date || '') : '' %>" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500">
        </div>
        <div>
          <label for="category_order" class="block text-sm font-medium text-gray-700 mb-1">Urutan Kategori</label>
          <input type="number" id="category_order" name="category_order" value="<%= isEdit ? (training?.category_order || 99) : '99' %>" min="0" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500">
        </div>
      </div>
      <div class="mt-4">
        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <select id="status" name="status" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500">
          <option value="active"  <%= isEdit && training?.status === 'active'  ? 'selected' : '' %>>Aktif</option>
          <option value="postpone" <%= isEdit && training?.status === 'postpone' ? 'selected' : '' %>>Postpone</option>
          <option value="full"     <%= isEdit && training?.status === 'full'     ? 'selected' : '' %>>Penuh</option>
        </select>
      </div>

      <!-- Reschedule Date (only show for postpone) -->
      <div id="reschedule-date-container" class="mt-4 <% if (!isEdit || training?.status !== 'postpone') { %>hidden<% } %>">
        <label for="reschedule_date" class="block text-sm font-medium text-gray-700 mb-1">Tanggal Dijadwalkan Ulang</label>
        <input type="date" id="reschedule_date" name="reschedule_date" value="<%= isEdit ? (training?.reschedule_date || '') : '' %>" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500">
        <p class="text-xs text-gray-500 mt-1">Kosongkan jika tanggal belum ditentukan</p>
      </div>

      <script>
        // Show/hide reschedule date based on status
        document.getElementById('status').addEventListener('change', function() {
          const container = document.getElementById('reschedule-date-container');
          if (this.value === 'postpone') {
            container.classList.remove('hidden');
          } else {
            container.classList.add('hidden');
          }
        });
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
          const statusSelect = document.getElementById('status');
          if (statusSelect && statusSelect.value === 'postpone') {
            document.getElementById('reschedule-date-container').classList.remove('hidden');
          }
        });
      </script>
    </div>

    <div class="px-6 py-4 border-t border-gray-100">
      <h2 class="text-base font-semibold text-gray-800 mb-4">Mode Pelaksanaan</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="exec_mode" class="block text-sm font-medium text-gray-700 mb-1">Mode Pelaksanaan</label>
          <select id="exec_mode" name="exec_mode" class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500">
            <option value="offline" <%= (!isEdit || training?.exec_mode === 'offline') ? 'selected' : '' %>>Offline (tatap muka)</option>
            <option value="online"  <%= isEdit && training?.exec_mode === 'online' ? 'selected' : '' %>>Online</option>
          </select>
        </div>
      </div>

      <!-- Fasilitas — hanya untuk offline -->
      <div id="fasilitas-container" class="mt-4">
        <label for="fasilitas" class="block text-sm font-medium text-gray-700 mb-1">Fasilitas yang Didapat Peserta</label>
        <textarea id="fasilitas" name="fasilitas" rows="5"
                  class="w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500
                         <%= (isEdit && training?.exec_mode === 'online') ? 'bg-gray-50 text-gray-400' : '' %>"
                  placeholder="Satu fasilitas per baris, contoh:&#10;Sertifikat resmi BNSP&#10;Materi digital&#10;Catering&#10;Akses WiFi &amp; Lab Komputer"><%= isEdit ? (training?.fasilitas || '') : '' %></textarea>
        <p class="text-xs text-gray-500 mt-1" id="fasilitas-hint">
          <%= (isEdit && training?.exec_mode === 'online')
            ? 'Mode Online — kolom ini tidak disimpan, hanya untuk offline.'
            : 'Khusus mode Offline. Satu fasilitas di setiap baris — akan ditampilkan ke peserta di halaman detail.' %>
        </p>
      </div>

      <script>
        document.getElementById('exec_mode').addEventListener('change', function() {
          const ta = document.getElementById('fasilitas')
          const hint = document.getElementById('fasilitas-hint')
          if (this.value === 'online') {
            ta.classList.add('bg-gray-50','text-gray-400')
            ta.placeholder = 'Mode Online — tidak disimpan'
            hint.textContent = 'Mode Online — kolom ini tidak disimpan, hanya untuk offline.'
          } else {
            ta.classList.remove('bg-gray-50','text-gray-400')
            ta.placeholder = 'Satu fasilitas per baris'
            hint.textContent = 'Khusus mode Offline. Satu fasilitas di setiap baris.'
          }
        })
      </script>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end gap-3">
      <a href="/admin/trainings" class="text-sm text-gray-600 hover:text-gray-800 transition-colors px-4 py-2">Batal</a>
      <button type="submit" class="bg-navy-700 hover:bg-navy-800 text-white text-sm font-semibold px-6 py-2 rounded-lg transition-colors shadow-sm">
        <%= isEdit ? 'Simpan Perubahan' : 'Tambah Pelatihan' %>
      </button>
    </div>
  </form>

</div>
</div>

<%- include('../layout/admin-footer') %>
