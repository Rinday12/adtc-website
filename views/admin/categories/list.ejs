<%- include('../../layout/header', { title, adminUser, currentPath }) %>
<%- include('../layout/sidebar', { adminUser, currentPath }) %>

<!-- Tombol buka sidebar di layar mobile -->
<button
  type="button"
  onclick="toggleSidebar()"
  class="lg:hidden fixed top-4 left-4 z-50 w-10 h-10 bg-navy-800 text-white rounded-lg shadow-lg flex items-center justify-center"
  aria-label="Buka menu"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
  </svg>
</button>

<!-- Main content — di-offset agar tidak tertutup sidebar di desktop -->
<div class="lg:pl-64">
<div class="max-w-6xl mx-auto px-4 py-6 lg:px-6">

  <!-- Page Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Manajemen Kategori</h1>
      <p class="text-gray-500 text-sm mt-1">Kelola kategori pelatihan yang tampil di navbar &amp; katalog</p>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="/admin/dashboard"
        class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-800 transition-colors border border-gray-300 hover:border-gray-400 rounded-lg px-4 py-2"
      >
        &larr; Dashboard
      </a>
      <a
        href="/admin/categories/create"
        class="inline-flex items-center gap-2 text-sm text-white bg-navy-700 hover:bg-navy-700 transition-colors rounded-lg px-4 py-2 font-medium shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Tambah Kategori
      </a>
    </div>
  </div>

  <!-- Categories Table -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <% if (categories && categories.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-gray-50 border-b border-gray-200 text-gray-600 uppercase text-xs tracking-wide">
            <tr>
              <th class="px-5 py-3 font-semibold">Nama</th>
              <th class="px-5 py-3 font-semibold">Anchor</th>
              <th class="px-5 py-3 font-semibold">Urutan</th>
              <th class="px-5 py-3 font-semibold">Gratis</th>
              <th class="px-5 py-3 font-semibold">Jml Training</th>
              <th class="px-5 py-3 font-semibold">Status</th>
              <th class="px-5 py-3 font-semibold sr-only">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% categories.forEach(function(cat) { %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-5 py-4 font-medium text-gray-900 whitespace-nowrap"><%= cat.name %></td>
                <td class="px-5 py-4 text-gray-500 font-mono text-xs"><%= cat.anchor %></td>
                <td class="px-5 py-4 text-gray-600"><%= cat.sort_order %></td>
                <td class="px-5 py-4">
                  <%
                    var tierLabel, tierClass
                    if (!cat.is_free_tier) {
                      tierLabel = 'Berbayar'
                      tierClass = 'bg-gray-100 text-gray-600 border-gray-200'
                    } else if (cat.cert_available === 0) {
                      tierLabel = 'Full free (Rp 0 total)'
                      tierClass = 'bg-green-100 text-green-800 border-green-200'
                    } else {
                      tierLabel = 'Gratis + paket komplit'
                      tierClass = 'bg-green-100 text-green-800 border-green-200'
                    }
                  %>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold border <%= tierClass %>"><%= tierLabel %></span>
                </td>
                <td class="px-5 py-4 text-gray-600"><%= (typeof usageCount !== 'undefined' && usageCount[cat.name]) ? usageCount[cat.name] : 0 %></td>
                <td class="px-5 py-4">
                  <% if (cat.status === 'aktif') { %>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-green-100 text-green-800 border-green-200">Aktif</span>
                  <% } else { %>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-gray-100 text-gray-600 border-gray-200">Nonaktif</span>
                  <% } %>
                </td>
                <td class="px-5 py-4">
                  <div class="flex items-center gap-3">
                    <a
                      href="/admin/categories/<%= cat.id %>/edit"
                      class="text-brand-500 hover:text-navy-800 hover:underline font-medium text-sm whitespace-nowrap"
                    >
                      Edit
                    </a>
                    <form method="POST" action="/admin/categories/<%= cat.id %>/delete"
                          onsubmit="return confirm('Hapus kategori <%= cat.name %>? Training terkait akan dipindahkan ke kategori cadangan.')">
                      <button
                        type="submit"
                        class="text-red-600 hover:text-red-800 hover:underline font-medium text-sm whitespace-nowrap"
                      >
                        Hapus
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="px-5 py-3 bg-gray-50 border-t border-gray-200 text-xs text-gray-500">
        Menampilkan <span class="font-medium text-gray-700"><%= categories.length %></span> kategori
      </div>

    <% } else { %>
      <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
        <svg class="w-14 h-14 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-gray-500 font-medium">Belum ada kategori.</p>
        <a href="/admin/categories/create" class="mt-3 text-sm text-brand-500 hover:underline">
          Tambah kategori pertama
        </a>
      </div>
    <% } %>
  </div>

  <!-- Catatan tipe biaya -->
  <p class="text-xs text-gray-400 mt-3">
    <span class="font-medium text-gray-500">Berbayar</span> = peserta membayar harga tier ·
    <span class="font-medium text-gray-500">Full free</span> = ikut Rp 0 total, tanpa opsi paket ·
    <span class="font-medium text-gray-500">Gratis + paket komplit</span> = ikut Rp 0, sertifikat/materi berbayar (diverifikasi admin).
  </p>

</div>
</div>

<%- include('../layout/admin-footer') %>
