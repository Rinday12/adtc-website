<%- include('../../layout/header', { title, adminUser, currentPath }) %>
<%- include('../layout/sidebar', { adminUser, currentPath }) %>

<!-- Tombol buka sidebar di layar mobile -->
<button
  type="button"
  onclick="toggleSidebar()"
  class="lg:hidden fixed top-4 left-4 z-50 w-10 h-10 bg-navy-800 text-white rounded-lg shadow-lg flex items-center justify-center"
  aria-label="Buka menu"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
  </svg>
</button>

<!-- Main content — di-offset agar tidak tertutup sidebar di desktop -->
<div class="lg:pl-64">
<div class="max-w-6xl mx-auto px-4 py-6 lg:px-6">

  <!-- Page Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Manajemen Berita</h1>
      <p class="text-gray-500 text-sm mt-1">Kelola artikel berita dan aktivitas ADTC</p>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="/admin/dashboard"
        class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-800 transition-colors border border-gray-300 hover:border-gray-400 rounded-lg px-4 py-2"
      >
        &larr; Dashboard
      </a>
      <a
        href="/admin/news/create"
        class="inline-flex items-center gap-2 text-sm text-white bg-navy-700 hover:bg-navy-700 transition-colors rounded-lg px-4 py-2 font-medium shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Tambah Berita Baru
      </a>
    </div>
  </div>

  <!-- News Table -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <% if (newsList && newsList.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-gray-50 border-b border-gray-200 text-gray-600 uppercase text-xs tracking-wide">
            <tr>
              <th class="px-5 py-3 font-semibold">Judul</th>
              <th class="px-5 py-3 font-semibold">Tanggal Publikasi</th>
              <th class="px-5 py-3 font-semibold sr-only">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% newsList.forEach(function(news) { %>
              <tr class="hover:bg-gray-50 transition-colors">

                <!-- Judul -->
                <td class="px-5 py-4 font-medium text-gray-900">
                  <%= news.title %>
                </td>

                <!-- Tanggal Publikasi -->
                <td class="px-5 py-4 text-gray-500 whitespace-nowrap">
                  <%= new Date(news.published_at).toLocaleDateString('id-ID', {
                    day: 'numeric', month: 'long', year: 'numeric'
                  }) %>
                </td>

                <!-- Aksi -->
                <td class="px-5 py-4">
                  <div class="flex items-center gap-3">
                    <a
                      href="/admin/news/<%= news.id %>/edit"
                      class="text-brand-500 hover:text-navy-800 hover:underline font-medium text-sm whitespace-nowrap"
                    >
                      Edit
                    </a>
                    <form method="POST" action="/admin/news/<%= news.id %>/delete">
                      <button
                        type="submit"
                        class="text-red-600 hover:text-red-800 hover:underline font-medium text-sm whitespace-nowrap"
                      >
                        Hapus
                      </button>
                    </form>
                  </div>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Row count summary -->
      <div class="px-5 py-3 bg-gray-50 border-t border-gray-200 text-xs text-gray-500">
        Menampilkan <span class="font-medium text-gray-700"><%= newsList.length %></span> berita
      </div>

    <% } else { %>
      <!-- Empty State -->
      <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
        <svg class="w-14 h-14 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-gray-500 font-medium">Belum ada berita.</p>
        <a href="/admin/news/create" class="mt-3 text-sm text-brand-500 hover:underline">
          Tambah berita pertama
        </a>
      </div>
    <% } %>
  </div>

</div>
</div>

<%- include('../layout/admin-footer') %>
