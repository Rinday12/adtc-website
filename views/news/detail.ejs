<%- include('../layout/header', { title }) %>

<div class="max-w-3xl mx-auto">

  <!-- Kembali -->
  <div class="mb-6">
    <a href="/berita" class="inline-flex items-center gap-1 text-sm text-brand-500 hover:text-navy-800 transition-colors">
      <span aria-hidden="true">&#8592;</span>
      Kembali ke Berita
    </a>
  </div>

  <article class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

    <!-- Gambar -->
    <% if (news.image_path) { %>
      <img
        src="/<%= news.image_path %>"
        alt="<%= news.title %>"
        class="w-full h-72 object-cover"
      />
    <% } %>

    <!-- Konten Artikel -->
    <div class="px-6 py-8 sm:px-10">

      <!-- Tanggal -->
      <%
        const pubDate = news.published_at
          ? new Date(news.published_at).toLocaleDateString('id-ID', {
              day: 'numeric', month: 'long', year: 'numeric'
            })
          : '-'
      %>
      <p class="text-sm text-gray-400 mb-3 flex items-center gap-1">
        <span aria-hidden="true">📅</span>
        <%= pubDate %>
      </p>

      <!-- Judul -->
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-snug mb-6">
        <%= news.title %>
      </h1>

      <!-- Garis pemisah -->
      <hr class="border-gray-100 mb-6" />

      <!-- Isi Berita -->
      <div class="text-gray-700 leading-relaxed whitespace-pre-wrap text-base">
        <%= news.content %>
      </div>

    </div>
  </article>

  <!-- Kembali bawah -->
  <div class="mt-8">
    <a href="/berita" class="inline-flex items-center gap-1 text-sm text-brand-500 hover:text-navy-800 transition-colors">
      <span aria-hidden="true">&#8592;</span>
      Kembali ke Berita
    </a>
  </div>

</div>

<%- include('../layout/footer') %>
