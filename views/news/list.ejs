<%- include('../layout/header', { title }) %>

<div class="max-w-6xl mx-auto">

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Berita & Aktivitas ADTC</h1>
    <p class="mt-1 text-gray-500">Ikuti perkembangan terbaru dari Ahmad Dahlan Training Center.</p>
  </div>

  <% if (newsList && newsList.length > 0) { %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% newsList.forEach(function(news) { %>
        <%
          const pubDate = news.published_at
            ? new Date(news.published_at).toLocaleDateString('id-ID', {
                day: 'numeric', month: 'long', year: 'numeric'
              })
            : '-'
        %>
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm flex flex-col hover:shadow-md transition-shadow overflow-hidden">

          <!-- Gambar -->
          <% if (news.image_path) { %>
            <img
              src="/<%= news.image_path %>"
              alt="<%= news.title %>"
              class="w-full h-48 object-cover"
            />
          <% } else { %>
            <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400 text-sm">
              Tidak ada gambar
            </div>
          <% } %>

          <!-- Konten Card -->
          <div class="px-5 py-4 flex flex-col flex-1 gap-3">

            <!-- Tanggal -->
            <p class="text-xs text-gray-400 flex items-center gap-1">
              <span aria-hidden="true">📅</span>
              <%= pubDate %>
            </p>

            <!-- Judul -->
            <h2 class="text-base font-semibold text-gray-800 leading-snug flex-1">
              <a href="/berita/<%= news.slug %>" class="hover:text-navy-700 transition-colors">
                <%= news.title %>
              </a>
            </h2>

            <!-- Link baca selengkapnya -->
            <a
              href="/berita/<%= news.slug %>"
              class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 hover:text-navy-800 transition-colors mt-auto"
            >
              Baca Selengkapnya
              <span aria-hidden="true">&#8594;</span>
            </a>

          </div>
        </div>
      <% }) %>
    </div>

  <% } else { %>

    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <div class="text-6xl mb-4" aria-hidden="true">📰</div>
      <h2 class="text-xl font-semibold text-gray-700 mb-1">Belum ada berita.</h2>
      <p class="text-gray-400 text-sm max-w-xs">
        Belum ada berita atau aktivitas yang dipublikasikan. Silakan kunjungi kembali halaman ini nanti.
      </p>
    </div>

  <% } %>

</div>

<%- include('../layout/footer') %>
