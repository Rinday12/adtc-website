<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'ADTC' %> | ADTC</title>
  <link rel="stylesheet" href="/css/output.css" />
  <link rel="icon" type="image/svg+xml" href="/images/logo/adtc-icon.svg">
  <link rel="apple-touch-icon" href="/images/logo/adtc-icon.svg">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <!-- ── Sticky Navbar ────────────────────────────────────────── -->
  <% if (typeof adminUser === 'undefined' || !adminUser) {
     // Navbar publik disembunyikan untuk semua halaman admin — adminUser sudah
     // di-set sebagai res.locals global oleh app.js (bukan hanya di adminController),
     // jadi cukup cek nilainya saja tanpa perlu per-pandangan per halaman.
  %>
  <nav id="main-nav" class="bg-navy-700 text-white shadow-lg sticky top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-navy-600">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between h-20">

        <!-- Ikon Emblem ADTC (pojok kiri atas) -->
        <a href="/" class="flex items-center justify-center w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 transition-colors shrink-0" title="ADTC">
          <img src="/images/logo/adtc-icon.svg" alt="ADTC Icon" class="w-5 h-5 rounded">
        </a>


        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-1 text-sm">
          <%
            const _isHome      = typeof currentPath !== 'undefined' && currentPath === '/'
            const _isTrainings = typeof currentPath !== 'undefined' && currentPath.startsWith('/trainings')
            const _isBerita    = typeof currentPath !== 'undefined' && currentPath.startsWith('/berita')
            const _cats        = typeof navCategories !== 'undefined' ? navCategories : []
          %>

          <!-- Beranda -->
          <a href="/"
             class="px-3 py-2 rounded-lg font-medium transition-colors
                    <%= _isHome ? 'text-brand-400 bg-white/10' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
            Beranda
          </a>

          <!-- Katalog Pelatihan + dropdown -->
          <div class="relative group/catalog">
            <button class="flex items-center gap-1 px-3 py-2 rounded-lg font-medium transition-colors
                           <%= _isTrainings ? 'text-brand-400 bg-white/10' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
              Katalog Pelatihan
              <!-- Chevron -->
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/catalog:rotate-180"
                   fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Dropdown panel -->
            <div class="absolute top-full left-0 mt-1 w-64 bg-white rounded-xl shadow-xl border border-gray-100
                        opacity-0 invisible translate-y-1
                        group-hover/catalog:opacity-100 group-hover/catalog:visible group-hover/catalog:translate-y-0
                        transition-all duration-200 origin-top-left">

              <!-- Link ke semua pelatihan -->
              <a href="/trainings"
                 class="flex items-center gap-2 px-4 py-3 text-sm text-gray-600 hover:bg-navy-50 hover:text-navy-700
                        font-semibold border-b border-gray-100 rounded-t-xl transition-colors">
                <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 6h16M4 10h16M4 14h16M4 18h7"/>
                </svg>
                Semua Pelatihan
              </a>

              <!-- Sub-menu per kategori -->
              <% if (_cats.length > 0) { %>
                <% _cats.forEach(function(cat, catIdx) { %>
                  <div class="relative group/cat">
                    <!-- Trigger kategori -->
                    <a href="/trainings#<%= cat.anchor %>"
                       class="flex items-center justify-between gap-2 px-4 py-2.5 text-sm text-gray-700
                              hover:bg-navy-50 hover:text-navy-700 transition-colors
                              <%= catIdx === _cats.length - 1 ? 'rounded-b-xl' : '' %>">
                      <span class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-brand-500 shrink-0"></span>
                        <span class="font-medium"><%= cat.category %></span>
                      </span>
                      <span class="flex items-center gap-1 text-gray-400">
                        <span class="text-xs bg-gray-100 text-gray-500 rounded-full px-1.5 py-0.5 font-medium">
                          <%= cat.count %>
                        </span>
                        <svg class="w-3 h-3 group-hover/cat:text-brand-500 transition-colors"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                        </svg>
                      </span>
                    </a>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="px-4 py-3 text-xs text-gray-400 italic">Belum ada kategori tersedia.</p>
              <% } %>
            </div>
          </div>

          <!-- Berita -->
          <a href="/berita"
             class="px-3 py-2 rounded-lg font-medium transition-colors
                    <%= _isBerita ? 'text-brand-400 bg-white/10' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
            Berita
          </a>

          <!-- Download Sertifikat -->
          <a href="/sertifikat"
             class="px-3 py-2 rounded-lg font-medium transition-colors
                    <%= currentPath === '/sertifikat' ? 'text-brand-400 bg-white/10' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
            Pusat Download
          </a>

          <!-- CTA -->
          <a href="/trainings"
             class="ml-2 px-4 py-2 rounded-lg bg-brand-500 hover:bg-brand-600 text-white
                    font-semibold transition-colors shadow-sm">
            Daftar Sekarang
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button id="mobile-menu-btn"
                class="md:hidden p-2 rounded-lg hover:bg-white/10 transition-colors focus:outline-none"
                aria-label="Buka menu" aria-expanded="false">
          <svg id="icon-open"  class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden hidden pb-4 border-t border-white/10 pt-3">
        <div class="flex flex-col gap-1">
          <a href="/"
             class="px-3 py-2 rounded-lg text-sm font-medium
                    <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'text-brand-400 bg-white/10' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
            Beranda
          </a>

          <!-- Katalog accordion mobile -->
          <div>
            <button id="mobile-catalog-btn"
                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium
                           <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/trainings') ? 'text-brand-400 bg-white/10' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
              <span>Katalog Pelatihan</span>
              <svg id="mobile-catalog-chevron" class="w-3.5 h-3.5 transition-transform duration-200"
                   fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <div id="mobile-catalog-sub" class="hidden pl-5 mt-1 flex flex-col gap-0.5">
              <a href="/trainings"
                 class="px-3 py-1.5 rounded-lg text-sm text-white/70 hover:text-white hover:bg-white/10 transition-colors">
                Semua Pelatihan
              </a>
              <% if (_cats.length > 0) { %>
                <% _cats.forEach(function(cat) { %>
                  <a href="/trainings#<%= cat.anchor %>"
                     class="px-3 py-1.5 rounded-lg text-sm text-white/70 hover:text-white hover:bg-white/10 transition-colors flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-400 shrink-0"></span>
                    <%= cat.category %>
                  </a>
                <% }) %>
              <% } %>
            </div>
          </div>

          <a href="/berita"
             class="px-3 py-2 rounded-lg text-sm font-medium
                    <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/berita') ? 'text-brand-400 bg-white/10' : 'text-white/80 hover:text-white hover:bg-white/10' %>">
            Berita
          </a>
          <a href="/trainings"
             class="mt-1 px-3 py-2 rounded-lg bg-brand-500 hover:bg-brand-600 text-white
                    font-semibold text-sm text-center transition-colors">
            Daftar Sekarang
          </a>
        </div>
      </div>
    </div>
  </nav>
  <% } %>

  <!-- Flash messages -->
  <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
    <div class="bg-green-50 border-l-4 border-green-500 text-green-800 px-4 py-3 mx-4 mt-4 rounded-r-lg flex items-center gap-2" role="alert">
      <svg class="w-5 h-5 shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <%= success_msg %>
    </div>
  <% } %>
  <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
    <div class="bg-red-50 border-l-4 border-red-500 text-red-800 px-4 py-3 mx-4 mt-4 rounded-r-lg flex items-center gap-2" role="alert">
      <svg class="w-5 h-5 shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-1-5a1 1 0 012 0v2a1 1 0 01-2 0v-2zm0-8a1 1 0 012 0v4a1 1 0 01-2 0V5z" clip-rule="evenodd"/>
      </svg>
      <%= error_msg %>
    </div>
  <% } %>

  <main class="container mx-auto px-4 py-8 flex-grow">

  <script>
    // Mobile hamburger toggle
    const mBtn   = document.getElementById('mobile-menu-btn')
    const mMenu  = document.getElementById('mobile-menu')
    const iOpen  = document.getElementById('icon-open')
    const iClose = document.getElementById('icon-close')
    if (mBtn && mMenu) {
      mBtn.addEventListener('click', () => {
        const open = mMenu.classList.toggle('hidden')
        iOpen.classList.toggle('hidden', !open)
        iClose.classList.toggle('hidden', open)
        mBtn.setAttribute('aria-expanded', String(!open))
      })
    }
    // Mobile katalog accordion
    const catBtn     = document.getElementById('mobile-catalog-btn')
    const catSub     = document.getElementById('mobile-catalog-sub')
    const catChevron = document.getElementById('mobile-catalog-chevron')
    if (catBtn && catSub) {
      catBtn.addEventListener('click', () => {
        catSub.classList.toggle('hidden')
        catChevron.classList.toggle('rotate-180')
      })
    }
  </script>
