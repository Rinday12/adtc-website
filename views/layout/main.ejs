<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | ADTC' : 'ADTC' %></title>
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <!-- Navbar -->
  <nav class="bg-brand-500 text-white shadow-md">
    <div class="container mx-auto px-4 py-3 flex justify-between items-center">
      <a href="/trainings" class="font-bold text-xl tracking-tight hover:text-blue-100 transition-colors">
        ADTC
      </a>
      <div class="flex items-center gap-4 text-sm">
        <a href="/trainings" class="hover:text-blue-100 transition-colors">Katalog Pelatihan</a>
      </div>
    </div>
  </nav>

  <!-- Flash Messages -->
  <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
    <% success_msg.forEach(function(msg) { %>
      <div class="bg-green-100 border border-green-400 text-green-800 px-4 py-3 mx-4 mt-4 rounded flex items-start gap-2" role="alert">
        <svg class="w-5 h-5 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span><%= msg %></span>
      </div>
    <% }) %>
  <% } %>

  <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
    <% error_msg.forEach(function(msg) { %>
      <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-3 mx-4 mt-4 rounded flex items-start gap-2" role="alert">
        <svg class="w-5 h-5 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-1-5a1 1 0 012 0v2a1 1 0 01-2 0v-2zm0-8a1 1 0 012 0v4a1 1 0 01-2 0V5z" clip-rule="evenodd"/>
        </svg>
        <span><%= msg %></span>
      </div>
    <% }) %>
  <% } %>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8 flex-grow">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-gray-300 text-center py-4 text-sm mt-auto">
    &copy; <%= new Date().getFullYear() %> Ahmad Dahlan Training Center
  </footer>

</body>
</html>
