<%- include('../layout/header', { title }) %>

<!-- Main Content -->
<main class="container mx-auto px-4 py-12 max-w-3xl">

  <!-- Header Section -->
  <div class="text-center mb-10">
    <div class="inline-flex items-center justify-center w-20 h-20 bg-navy-700 rounded-full mb-4">
      <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946A3.42 3.42 0 019 12z"/>
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Pusat Download Sertifikat</h1>
    <p class="text-gray-500 max-w-md mx-auto">Masukkan kode referensi untuk mengunduh sertifikat pelatihan Anda</p>
  </div>

  <!-- Error Message -->
  <% if (error) { %>
    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded-r-lg mb-6" role="alert">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <span><%= error %></span>
      </div>
    </div>
  <% } %>

  <!-- Success - Show Registration Data -->
  <% if (registration) { %>
    <div class="bg-green-50 border-l-4 border-green-500 text-green-700 px-4 py-3 rounded-r-lg mb-6">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <div>
          <p class="font-medium">Sertifikat siap diunduh!</p>
          <p class="text-sm mt-1">Data pendaftaran telah diverifikasi.</p>
        </div>
      </div>
    </div>

    <!-- Registration Info Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        Data Peserta
      </h2>
      <div class="space-y-3">
        <div class="flex justify-between items-center py-2 border-b border-gray-100">
          <span class="text-gray-500">Nama Lengkap</span>
          <span class="font-medium text-gray-800"><%= registration.full_name %></span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-gray-100">
          <span class="text-gray-500">Email</span>
          <span class="font-medium text-gray-800"><%= registration.email %></span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-gray-100">
          <span class="text-gray-500">Pelatihan</span>
          <span class="font-medium text-gray-800"><%= registration.training_title %></span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-gray-100">
          <span class="text-gray-500">Kode Referensi</span>
          <span class="font-mono font-bold text-brand-600 bg-brand-50 px-2 py-1 rounded"><%= registration.reference_code %></span>
        </div>
        <div class="flex justify-between items-center py-2">
          <span class="text-gray-500">Status</span>
          <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            Terverifikasi
          </span>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Download Button -->
  <% if (registration && registration.status === 'verified') { %>
    <div class="text-center mb-8">
      <% if (registration.certificate_url) { %>
        <a href="<%= registration.certificate_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-flex items-center gap-3 bg-green-600 hover:bg-green-700 text-white font-semibold px-8 py-4 rounded-xl transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 19v-8a2 2 0 01.586-1.414l5-5A2 2 0 019.414 3h5a2 2 0 011.414.586l5 5A2 2 0 0122 11v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          </svg>
          Download Sertifikat dari Google Drive
        </a>
        <p class="text-sm text-gray-400 mt-3">Klik tombol di atas untuk mengunduh sertifikat dari Google Drive</p>
      <% } else { %>
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl px-6 py-4 max-w-md mx-auto">
          <p class="text-yellow-700 font-medium">Sertifikat belum tersedia</p>
          <p class="text-yellow-600 text-sm mt-1">Silakan hubungi admin ADTC untuk mendapatkan link sertifikat.</p>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Search Form -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-navy-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      Cari Sertifikat
    </h2>
    <form action="/sertifikat/search" method="POST">
      <div class="mb-4">
        <label for="kode_referensi" class="block text-sm font-medium text-gray-700 mb-2">
          Kode Referensi
        </label>
        <input type="text"
               id="kode_referensi"
               name="kode_referensi"
               value="<%= typeof kodeRef !== 'undefined' ? kodeRef : '' %>"
               placeholder="Contoh: ADTC-2026-1234"
               class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-navy-500 focus:border-navy-500 transition-colors uppercase font-mono"
               required>
        <p class="text-xs text-gray-400 mt-1">Kode ini didapat saat proses pendaftaran berhasil</p>
      </div>

      <button type="submit"
              class="w-full bg-navy-700 hover:bg-navy-800 text-white font-semibold px-6 py-3 rounded-lg transition-colors flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        Cari Sertifikat
      </button>
    </form>
  </div>

  <!-- How to Get Reference Code -->
  <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
    <h3 class="font-semibold text-blue-800 mb-4 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Cara Mendapatkan Kode Referensi
    </h3>
    <ol class="text-sm text-blue-700 space-y-2 list-decimal list-inside">
      <li>Setelah mendaftar pelatihan, Anda akan menerima halaman sukses dengan kode referensi</li>
      <li>Kode referensi berbentuk: <code class="bg-blue-100 px-1 py-0.5 rounded font-mono">ADTC-YYYY-NNNN</code></li>
      <li>Simpan kode ini dengan baik untuk mengunduh sertifikat nanti</li>
      <li>Sertifikat hanya tersedia setelah status pendaftaran <strong>Verified</strong></li>
    </ol>
  </div>

  <!-- Info Section -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6">
    <h3 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Informasi Penting
    </h3>
    <ul class="text-sm text-gray-600 space-y-2">
      <li class="flex items-start gap-2">
        <span class="text-green-500 mt-0.5">•</span>
        <span>Sertifikat hanya dapat diunduh jika status sudah <strong class="text-gray-800">Verified</strong></span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-green-500 mt-0.5">•</span>
        <span>Sertifikat dalam format PDF dan dapat dicetak untuk kebutuhan dokumen resmi</span>
      </li>
      <li class="flex items-start gap-2">
        <span class="text-green-500 mt-0.5">•</span>
        <span>Hubungi admin jika mengalami kesulitan mengakses sertifikat</span>
      </li>
    </ul>
  </div>

  <!-- Contact Help -->
  <div class="mt-6 text-center">
    <p class="text-sm text-gray-500">Butuh bantuan?</p>
    <a href="https://wa.me/6281226730716?text=Halo%20Admin%20ADTC%2C%20saya%20ingin%20menanyakan%20tentang%20sertifikat%20pelatihan"
       target="_blank"
       rel="noopener noreferrer"
       class="inline-flex items-center gap-2 mt-2 text-green-600 hover:text-green-700 font-medium text-sm">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.87 9.87 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Hubungi Admin via WhatsApp
    </a>
  </div>

</main>

<%- include('../layout/footer') %>
