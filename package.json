{
  "name": "adtc-website",
  "version": "1.0.0",
  "description": "Ahmad Dahlan Training Center - Platform website pelatihan berbasis web",
  "main": "app.js",
  "scripts": {
    "start": "bash scripts/server.sh start",
    "stop": "bash scripts/server.sh stop",
    "restart": "bash scripts/server.sh restart",
    "status": "bash scripts/server.sh status",
    "dev": "bash scripts/server.sh stop && nodemon app.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css",
    "test": "jest --testEnvironment node"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "connect-flash": "0.1.1",
    "dotenv": "16.3.1",
    "ejs": "3.1.9",
    "express": "4.18.2",
    "express-session": "1.17.3",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.6.1",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.20.2",
    "slugify": "1.6.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "fast-check": "3.14.0",
    "jest": "29.7.0",
    "nodemon": "3.0.1",
    "tailwindcss": "3.3.5"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js"
    ]
  }
}
